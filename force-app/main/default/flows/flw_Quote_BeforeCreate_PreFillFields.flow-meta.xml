<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>asn_BillTo</name>
        <label>Assign Bill-to</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>billToAccount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>lp_PartnerFunctions.ReferencedAccount__r.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>lp_PartnerFunctions</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>asn_ShipTo</name>
        <label>Assign Ship-to</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>shipToAccount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>lp_PartnerFunctions.ReferencedAccount__r.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>lp_PartnerFunctions</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>decn_AreFound</name>
        <label>Are Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>upd_QuoteFields</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>decn_AreFound_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>partnerFunction</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>lp_PartnerFunctions</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>decn_BillToShipTo</name>
        <label>Bill-to or Ship-to?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>BillTo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>lp_PartnerFunctions.mdr_BoschPartnerFunction__r.txt_PartnerFunction__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>asn_BillTo</targetReference>
            </connector>
            <label>Bill-to</label>
        </rules>
        <rules>
            <name>ShipTo</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>lp_PartnerFunctions.mdr_BoschPartnerFunction__r.txt_PartnerFunction__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SH</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>asn_ShipTo</targetReference>
            </connector>
            <label>Ship-to</label>
        </rules>
    </decisions>
    <decisions>
        <name>decn_IsOpportunityFrameContractRecordType</name>
        <label>Is Opportunity Frame Contract Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>decn_IsOpportunityFrameContractRecordType_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SBQQ__Opportunity2__r.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>FrameContract</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>upd_GenerateContractedPrice</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Populate Bill-to Account, Ship-to Account and Currency</description>
    <environments>Default</environments>
    <formulas>
        <name>fnum_CalculateVersionNumber</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!get_OtherQuotesOfRelatedOpportunity.num_QuoteVersion__c}), 1, {!get_OtherQuotesOfRelatedOpportunity.num_QuoteVersion__c} +1)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Quote_BeforeCreate_PreFill Fields {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote BeforeCreate PreFill Fields</label>
    <loops>
        <name>lp_PartnerFunctions</name>
        <label>Loop Partner Functions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>partnerFunction</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>decn_BillToShipTo</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>upd_QuoteFields</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Queries for other quotes that are related to the parent Opportunity. And gets the Quote Version of the one that was created latest.</description>
        <name>get_OtherQuotesOfRelatedOpportunity</name>
        <label>Get other Quotes of related Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>get_PartnerFunctions</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__Opportunity2__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SBQQ__Opportunity2__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>SBQQ__Quote__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>num_QuoteVersion__c</queriedFields>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>get_PartnerFunctions</name>
        <label>Get Partner Functions</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>decn_AreFound</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ReferencedAccount__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SBQQ__Opportunity2__r.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>lkp_SalesDataCustomer__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.SBQQ__Opportunity2__r.lkp_SalesDataCustomer__c</elementReference>
            </value>
        </filters>
        <object>BoschPartner_PartnerFunction__c</object>
        <outputReference>partnerFunction</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>mdr_BoschPartnerFunction__c</queriedFields>
        <queriedFields>ReferencedAccount__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>upd_GenerateContractedPrice</name>
        <label>Update Generate Contracted Price</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>SBQQ__GenerateContractedPrice__c</field>
            <value>
                <stringValue>Price</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>upd_QuoteFields</name>
        <label>Update Quote Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>decn_IsOpportunityFrameContractRecordType</targetReference>
        </connector>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <elementReference>$Record.SBQQ__Opportunity2__r.CurrencyIsoCode</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>lkp_BillToAccount__c</field>
            <value>
                <elementReference>billToAccount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>lkp_ShipToAccount__c</field>
            <value>
                <elementReference>shipToAccount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>num_QuoteVersion__c</field>
            <value>
                <elementReference>fnum_CalculateVersionNumber</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>get_OtherQuotesOfRelatedOpportunity</targetReference>
        </connector>
        <object>SBQQ__Quote__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
