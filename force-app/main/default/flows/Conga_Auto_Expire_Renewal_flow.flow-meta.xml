<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <decisions>
        <description>Check if auto renew is true</description>
        <name>Check_if_auto_renew_is_true</name>
        <label>Check if auto renew is true</label>
        <locationX>314</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Auto_renew</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Apttus__Auto_Renewal__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Apttus__Auto_Renew_Term_Months__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Apttus__Contract_End_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_end_date_and_renew_flag</targetReference>
            </connector>
            <label>Auto renew</label>
        </rules>
        <rules>
            <name>Auto_Expire</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Apttus__Contract_End_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Auto_expire_if_auto_renew_is_false</targetReference>
            </connector>
            <label>Auto Expire</label>
        </rules>
    </decisions>
    <description>When the agreement reaches its end date this flow will check whether the agreement has auto renewal flag true or not, if the auto renewal flag is false then the flow will simply turn the status and status category to Expired Expired, and if the auto renewal flag is true and Term months is not null then the flow will renew the agreement and add the term months to the end date and turn the renewal flag to false after renewing the agreement.</description>
    <environments>Default</environments>
    <formulas>
        <description>Calculate new end date</description>
        <name>Calculatenewenddate</name>
        <dataType>Date</dataType>
        <expression>AddMonths({!$Record.Apttus__Contract_End_Date__c},{!$Record.Apttus__Auto_Renew_Term_Months__c})</expression>
    </formulas>
    <interviewLabel>Conga Auto Expire/Renewal flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Conga Auto Expire/Renewal flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Auto expire if auto renew is false</description>
        <name>Auto_expire_if_auto_renew_is_false</name>
        <label>Auto expire if auto renew is false</label>
        <locationX>314</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>Apttus__Status_Category__c</field>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Apttus__Status__c</field>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Update end date and renew flag</description>
        <name>Update_end_date_and_renew_flag</name>
        <label>Update end date and renew flag</label>
        <locationX>50</locationX>
        <locationY>360</locationY>
        <inputAssignments>
            <field>Apttus__Auto_Renewal__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Apttus__Contract_End_Date__c</field>
            <value>
                <elementReference>Calculatenewenddate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_if_auto_renew_is_true</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Apttus__Status_Category__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>In Effect</stringValue>
            </value>
        </filters>
        <filters>
            <field>Apttus__Status_Category__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Import</stringValue>
            </value>
        </filters>
        <filters>
            <field>Apttus__Status_Category__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>In Filing</stringValue>
            </value>
        </filters>
        <object>Apttus__APTS_Agreement__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2022-08-04</startDate>
            <startTime>07:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
</Flow>
