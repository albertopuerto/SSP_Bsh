    <formulas>
        <name>AccountOwnerRecipientFormula</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    {!$Record.Account.OwnerId} &lt;&gt; {!$Record.LastModifiedById},
    NOT(CONTAINS({!notifiedUserIds}, {!$Record.Account.OwnerId}))
  ),
  {!$Record.Account.OwnerId},
  NULL
)</expression>
    </formulas>
    <formulas>
        <name>AccountTeamMemberRecipientFormula</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    {!OppTeamLoop.UserId} &lt;&gt; {!$Record.LastModifiedById},
    NOT(CONTAINS({!notifiedUserIds}, {!OppTeamLoop.UserId}))
  ),
  {!OppTeamLoop.UserId},
  NULL
)</expression>
    </formulas>
    <formulas>
        <name>Doesusernotified</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!notifiedUserIds}, {!$Record.OwnerId}))</expression>
    </formulas>
    <formulas>
        <name>DoesUserNotified_2</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!notifiedUserIds}, {!$Record.Account.OwnerId}))</expression>
    </formulas>
    <formulas>
        <name>DoesUserNotified_3</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!notifiedUserIds}, {!currentOpportunityTeamMember.UserId}))</expression>
    </formulas>
    <formulas>
        <name>DoesuserNotified_4</name>
        <dataType>Boolean</dataType>
        <expression>NOT(CONTAINS({!notifiedUserIds}, {!currentAccountTeamMember.UserId}))</expression>
    </formulas>
    <formulas>
        <name>OpportunityRecipientFormula</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    {!$Record.OwnerId} &lt;&gt; {!$Record.LastModifiedById},
    NOT(CONTAINS({!notifiedUserIds}, {!$Record.OwnerId}))
  ),
  {!$Record.OwnerId},
  NULL
)</expression>
    </formulas>
    <formulas>
        <name>OpportunityTeamMemberRecipientFormula</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    {!currentOpportunityTeamMember.UserId} &lt;&gt; {!$Record.LastModifiedById},
    NOT(CONTAINS({!notifiedUserIds}, {!currentOpportunityTeamMember.UserId}))
  ),
  {!currentOpportunityTeamMember.UserId},
  NULL
)</expression>
    </formulas>
