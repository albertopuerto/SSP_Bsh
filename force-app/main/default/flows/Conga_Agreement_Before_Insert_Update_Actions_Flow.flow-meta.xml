    <decisions>
        <name>Update_Agreement_fields_when_cancelled</name>
        <label>Update Agreement fields when cancelled</label>
        <locationX>328</locationX>
        <locationY>272</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_the_Agreement_is_Cancelled</name>
            <conditionLogic>((1 AND (2 OR 6 OR 8 OR 10 OR 12)) OR (3 AND ((4 AND 2) OR (5 AND 6) OR (7 AND 8) OR (9 AND 10) OR (11 AND 12))))</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Apttus_Approval__Approval_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Apttus_Approval__Approval_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Cancelled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.APTS_Payment_Terms__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Other</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.APTS_Payment_Terms__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Other</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.APTS_Indemnification_Categories__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Non-Standard</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.APTS_Indemnification_Categories__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non-Standard</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.APTS_Limitation_of_Liability__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.APTS_Limitation_of_Liability__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.APTS_Tax__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Non-Standard</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.APTS_Tax__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non-Standard</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Approval_Status</targetReference>
            </connector>
            <label>Check if the Agreement is Cancelled</label>
        </rules>
        <rules>
            <name>Check_if_the_Agreement_is_Amended</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Apttus__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Amendment</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Agreement_Signature_Type_Approval_Status</targetReference>
            </connector>
            <label>Check if the Agreement is Amended</label>
        </rules>
        <rules>
            <name>Check_if_Agreement_is_Created_or_Account_is_Changed</name>
            <conditionLogic>(3 OR 4 OR 5 OR (1 AND 2))</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Apttus__Account__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Apttus__Account__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.APTS_Processor__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Apttus__Contract_Start_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Check if Agreement is Created or Account or Start Date is Changed</label>
        </rules>
    </decisions>
    <description>Add Start Date</description>
    <environments>Default</environments>
    <formulas>
        <description>Defaults the Account to the Processor</description>
        <name>Account_or_Processor</name>
        <dataType>String</dataType>
        <expression>IF(ISNULL({!$Record.Apttus__Account__c}),{!$Record.APTS_Processor__c},{!$Record.Apttus__Account__c})</expression>
    </formulas>
    <formulas>
        <name>Agreement_Name</name>
        <dataType>String</dataType>
        <expression>IF(
  ISPICKVAL({!$Record.Apttus__Agreement_Category__c}, &quot;Privacy&quot;), {!$Record.Name}, 
  {!$Record.RecordType.Name}+&#39;--&#39;+IF(ISBLANK({!$Record.Apttus__Account__c}),{!$Record.APTS_Processor__r.Name},{!$Record.Apttus__Account__r.Name})+&#39;--&#39;+TEXT(Month( {!$Record.Apttus__Contract_Start_Date__c} )) + &#39;-&#39;
+ TEXT(Day({!$Record.Apttus__Contract_Start_Date__c} )) + &#39;-&#39;
+ TEXT(Year ({!$Record.Apttus__Contract_Start_Date__c} ))
)</expression>
    </formulas>
    <formulas>
        <name>Default_Start_Date_To_Today</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.Apttus__Contract_Start_Date__c}),TODAY(),($Record.Apttus__Contract_Start_Date__c))</expression>
    </formulas>
    <formulas>
        <name>Perpetual</name>
        <dataType>Boolean</dataType>
        <expression>ISNULL({!$Record.Apttus__Contract_End_Date__c})</expression>
    </formulas>
    <formulas>
        <name>Queue_Name</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.Apttus__Agreement_Category__c}, &#39;Sales&#39;, &#39;SA1/GM&#39;, &#39;Privacy&#39;, &#39;EB&#39;,&#39;Error&#39;)</expression>
    </formulas>
