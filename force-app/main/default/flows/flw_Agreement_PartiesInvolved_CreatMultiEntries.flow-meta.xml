<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_for_MultiPary_Agreement</name>
        <label>Check for MultiPary Agreement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>MultiPartyInvolved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pkl_Parties_Involved__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Multy-Party</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateCustomerParty</targetReference>
            </connector>
            <label>Check for MultiPary Agreement</label>
        </rules>
    </decisions>
    <decisions>
        <name>TryToFindARecordID</name>
        <label>TryToFindARecordID_CheckInEmptyList</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_for_MultiPary_Agreement</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CheckInEmptyListAgrePartyRecord</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SearchForExistingAgrPartyRecord</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Multi_Agreement_Parties_Records</targetReference>
            </connector>
            <label>CheckInEmptyListAgrePartyRecord</label>
        </rules>
    </decisions>
    <description>Dynamically be able to create records for Multiparty Agreements</description>
    <environments>Default</environments>
    <interviewLabel>Agreement Parties Involved {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Agreement Two Multi Parties Involved</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>In Multiparty Agreements- create as many customer parties as involved in</description>
        <name>CreateCustomerParty</name>
        <label>Create Customer Party</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>CreateETASLegalEntityEntry</targetReference>
        </connector>
        <inputAssignments>
            <field>dat_MultyPartySignedDate__c</field>
            <value>
                <elementReference>$Record.Apttus__Other_Party_Signed_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>lkp_AgreementParty__c</field>
            <value>
                <elementReference>$Record.Apttus__Account__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>lkp_MultiPartySignedBy__c</field>
            <value>
                <elementReference>$Record.Apttus__Other_Party_Signed_By__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>mdr_Agreement__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>pkl_MultyPartySignatureType__c</field>
            <value>
                <elementReference>$Record.pkl_TypeOfOtherPartySignature__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>pkl_PartyRole__c</field>
            <value>
                <stringValue>Customer</stringValue>
            </value>
        </inputAssignments>
        <object>Apttus_AgreementParty__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>In Multiparty Agreements- create as many ETAS Legal Entities as involved in</description>
        <name>CreateETASLegalEntityEntry</name>
        <label>Create ETAS Legal Entity Entry</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>dat_MultyPartySignedDate__c</field>
            <value>
                <elementReference>$Record.Apttus__Company_Signed_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>lkp_AgreementParty__c</field>
            <value>
                <elementReference>$Record.APTS_Internal_Legal_Entity__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>lkp_MultiPartySignedBy__c</field>
            <value>
                <elementReference>$Record.Apttus__Company_Signed_By__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>mdr_Agreement__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>pkl_MultyPartySignatureType__c</field>
            <value>
                <elementReference>$Record.APTS_Type_of_Signature__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>pkl_PartyRole__c</field>
            <value>
                <stringValue>ETAS Legal Entity</stringValue>
            </value>
        </inputAssignments>
        <object>Apttus_AgreementParty__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordDeletes>
        <description>If an agreement type is changed from multi to two- party, the related multi-party records should be deleted</description>
        <name>Delete_Multi_Agreement_Parties_Records</name>
        <label>Delete Multi Agreement Parties Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_MultiPary_Agreement</targetReference>
        </connector>
        <inputReference>SearchForExistingAgrPartyRecord</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>SearchForExistingAgrPartyRecord</name>
        <label>SearchForExistingAgrPartyRecord</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>TryToFindARecordID</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>mdr_Agreement__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Apttus_AgreementParty__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>SearchForExistingAgrPartyRecord</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>Apttus__Account__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>APTS_Internal_Legal_Entity__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>pkl_Parties_Involved__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Multy-Party</stringValue>
            </value>
        </filters>
        <filters>
            <field>pkl_Parties_Involved__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Two-Party</stringValue>
            </value>
        </filters>
        <object>Apttus__APTS_Agreement__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
