    <decisions>
        <description>Checks if the Opportunity owner is a member of the Account Team</description>
        <name>decn_IsOppOwnerAccountTeamMember</name>
        <label>Is Opportunity Owner Account Team Member?</label>
        <locationX>270</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>asgn_TeamRole</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>decn_IsOppOwnerAccountTeamMember_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
