<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Comments_Required_for_Approval</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(sbaa__Status__c, &#39;Approved&#39;),
ISBLANK(sbaa__CommentsLong__c),
NOT($Permission.BypassValidations)
)</errorConditionFormula>
    <errorMessage>Please provide a comment</errorMessage>
</ValidationRule>
