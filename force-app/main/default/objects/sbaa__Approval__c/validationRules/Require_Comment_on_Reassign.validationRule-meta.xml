<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Comment_on_Reassign</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
     ISCHANGED(sbaa__AssignedTo__c),

     ISBLANK(sbaa__CommentsLong__c) 

)</errorConditionFormula>
    <errorMessage>Comments can&#39;t be empty on reassign</errorMessage>
</ValidationRule>
