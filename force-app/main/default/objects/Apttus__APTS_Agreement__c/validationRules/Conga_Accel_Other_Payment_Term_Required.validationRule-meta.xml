<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Conga_Accel_Other_Payment_Term_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(APTS_Payment_Terms__c,&quot;Other&quot;),ISBLANK( APTS_Other_Payment_Term__c))</errorConditionFormula>
    <errorDisplayField>APTS_Other_Payment_Term__c</errorDisplayField>
    <errorMessage>Payment Term is selected &quot;Other&quot;, please specify</errorMessage>
</ValidationRule>
