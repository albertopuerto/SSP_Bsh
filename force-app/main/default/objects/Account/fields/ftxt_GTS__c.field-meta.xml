<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ftxt_GTS__c</fullName>
    <description>Indicate if the Customer Block is set. Field is updated by integration with an external system.</description>
    <externalId>false</externalId>
    <formula>IF(chk_CustomerBlock__c, IMAGE(&quot;/img/samples/color_red.gif&quot;, &quot;red&quot;, 20, 20), IMAGE(&quot;/img/samples/color_green.gif&quot;, &quot;green&quot;, 20, 20))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Green = Released
Red = Blocked</inlineHelpText>
    <label>GTS</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
