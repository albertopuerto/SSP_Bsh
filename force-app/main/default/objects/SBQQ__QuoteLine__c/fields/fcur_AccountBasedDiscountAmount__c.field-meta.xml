<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>fcur_AccountBasedDiscountAmount__c</fullName>
    <description>Account based discount in terms of absolute amount. This discount is calculated based on the contracted price for a specific account.</description>
    <externalId>false</externalId>
    <formula>SBQQ__ListPrice__c -  SBQQ__ContractedPrice__r.SBQQ__Price__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Account Based Disc. (Amt)</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
