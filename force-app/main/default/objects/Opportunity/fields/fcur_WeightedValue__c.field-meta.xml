<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>fcur_WeightedValue__c</fullName>
    <description>Competition Rating-adjusted expected amount (Expected Amount = Expected value *Competition Rating)</description>
    <externalId>false</externalId>
    <formula>If(ISBLANK(cur_ExpectedValue__c) || ISBLANK(TEXT(pkl_CompetitionRating__c)), NULL, cur_ExpectedValue__c * VALUE(SUBSTITUTE(TEXT(pkl_CompetitionRating__c), &quot;%&quot;, &quot;&quot;)) / 100)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Competition Rating-adjusted expected amount (Expected Amount = Expected value *Competition Rating)</inlineHelpText>
    <label>Weighted Value</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
