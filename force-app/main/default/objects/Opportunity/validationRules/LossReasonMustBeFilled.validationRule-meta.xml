<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LossReasonMustBeFilled</fullName>
    <active>true</active>
    <description>Loss reason must be filled when the opportunity is closed lost</description>
    <errorConditionFormula>ISPICKVAL( StageName , &quot;Closed Lost&quot;) &amp;&amp; 
ISPICKVAL(pkl_LossReason__c, &#39;&#39;)
 &amp;&amp; NOT($Permission.BypassValidations)</errorConditionFormula>
    <errorDisplayField>pkl_LossReason__c</errorDisplayField>
    <errorMessage>The loss reason must be provided when the opportunity is closed lost</errorMessage>
</ValidationRule>
