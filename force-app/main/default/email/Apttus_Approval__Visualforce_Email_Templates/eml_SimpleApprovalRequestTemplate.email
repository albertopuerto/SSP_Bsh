<messaging:emailTemplate subject="Quote for Approval" recipientType="User" relatedToType="sbaa__Approval__c">
<messaging:htmlEmailBody >
<p style="color:white"><apex:outputText value="{!relatedTo.ID}"/></p>
<div class="email-content">
            <p>Dear <strong>{!relatedTo.sbaa__AssignedTo__r.Name}</strong>,</p>
            <p>We need to inform you that the quote <strong><a href="{!LEFT($Api.Enterprise_Server_URL_620,FIND("/services", $Api.Enterprise_Server_URL_620))}/lightning/r/SBQQ__Quote__c/{!relatedTo.Quote__r.Id}/view">{!relatedTo.Quote__r.Name}</a></strong> needs your approval!</p>
            <p><strong>Opportunity:</strong> {!relatedTo.Quote__r.SBQQ__Opportunity2__r.Name} </p>
            <p><strong>Account:</strong> {!relatedTo.Quote__r.SBQQ__Account__r.Name} </p>
            <p><strong>Primary Contact:</strong> {!relatedTo.Quote__r.SBQQ__PrimaryContact__r.Name}</p>
        </div>        
        <p>
        To approve or reject this request, you may reply to this message with one of the words: <strong>“Approve”, “Approved”, “Yes”,</strong> or <strong>“Reject”, “Rejected”, “No”</strong> on the first line of the email. You may comment on your response on the second line.
    </p>
</messaging:htmlEmailBody>
</messaging:emailTemplate>