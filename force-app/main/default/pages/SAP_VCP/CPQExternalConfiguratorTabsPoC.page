    function callAPI(endpoint) {
        let method, params = {}, outputId;
        
        switch(endpoint) {
            case 'determine':
                method = 'determineKnowledgebase';
                params = { 
                    productId: document.getElementById('determine-productId').value,
                    validityDate: document.getElementById('determine-validityDate').value,
                    type: document.getElementById('determine-type').value,
                    plant: document.getElementById('determine-plant').value
                };
                outputId = 'output-determine';
                break;
            case 'get-kb':
                method = 'getKnowledgebaseById';
                params = { kbId: document.getElementById('input-kbid').value };
                outputId = 'output-get-kb';
                break;
            case 'get-translations':
                method = 'getKnowledgebaseTranslations';
                params = { 
                    kbId: document.getElementById('input-kb-trans-id').value,
                    language: document.getElementById('input-kb-trans-language').value
                };
                outputId = 'output-get-translations';
                break;
            case 'create':
                method = 'createConfigurationV2';
                const payload = buildConfigurationPayload();
                params = { configData: JSON.stringify(payload) };
                outputId = 'output-create';
                break;
            case 'patch':
                method = 'patchConfigurationV2';
                params = { 
                    configId: document.getElementById('input-patch-id').value,
                    patchData: document.getElementById('input-patch').value
                };
                outputId = 'output-patch';
                break;
            case 'get':
                method = 'getConfigurationV2';
                params = { configId: document.getElementById('input-get-id').value };
                outputId = 'output-get';
                break;
            case 'pricing':
                method = 'callPricingService';
                params = { pricingData: document.getElementById('input-pricing').value };
                outputId = 'output-pricing';
                break;
            case 'delete':
                method = 'completeConfigurationV2';
                params = { configId: document.getElementById('input-delete-id').value };
                outputId = 'output-delete';
                break;
        }
        
        try {
            const textarea = document.getElementById(outputId);
            textarea.value = 'Loading...';
            const tableId = outputId ? outputId.replace('output-', 'table-') : null;
            if (tableId) {
                clearTable(tableId);
            }
            
            const result = sforce.apex.execute('CPQExternalConfiguratorControllerPoC', method, params);
            
            let formatted = '';
            try {
                const parsed = JSON.parse(result);
                formatted = JSON.stringify(parsed, null, 2);
                if (tableId) {
                    renderTable(parsed, tableId);
                }
                if (endpoint === 'get') {
                    renderConfigurationForm(parsed, 'config-form-container', { editable: false, storeOriginal: false });
                } else {
                    clearConfigurationForm('config-form-container');
                }
            } catch (e) {
                formatted = result;
                if (tableId) {
                    clearTable(tableId);
                }
                clearConfigurationForm('config-form-container');
            }
            
            textarea.value = formatted;
            
        } catch (error) {
            document.getElementById(outputId).value = 'Error: ' + error.message;
            const tableId = outputId ? outputId.replace('output-', 'table-') : null;
            if (tableId) {
                clearTable(tableId);
            }
            clearConfigurationForm('config-form-container');
        }
    }

