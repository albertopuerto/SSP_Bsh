        }

        .config-group-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .config-group-pill {
            background: #f3f6f9;
            color: #16325c;
            border: 1px solid #d8dada;
            border-radius: 999px;
            padding: 4px 10px;
