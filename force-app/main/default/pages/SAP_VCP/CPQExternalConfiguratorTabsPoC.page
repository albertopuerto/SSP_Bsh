            border-radius: 4px;
            padding: 15px;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            color: #333;
            line-height: 1.5;
            max-height: 400px;
            overflow-y: auto;
            white-space: pre-wrap;
            word-break: break-word;
        }
        
        .form-section input,
        .form-section textarea {
            width: 100%;
            max-width: 600px;
            padding: 10px 12px;
            border: 1px solid #d8dada;
