        }

        .config-form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
        }

        .config-field {
            background: #ffffff;
            border: 1px solid #e5e5e5;
            border-radius: 6px;
            padding: 12px;
        }

        .config-field.readonly {
            opacity: 0.7;
        }

        .config-field-title {
            font-weight: 600;
            color: #16325c;
            margin-bottom: 8px;
            font-size: 13px;
        }

        .required-indicator {
            color: #c23934;
            margin-left: 4px;
        }

        .config-field-options {
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 12px;
            color: #333;
        }

        .config-field .meta {
            margin-top: 6px;
            font-size: 11px;
            color: #706e6b;
        }
        
        .status-message {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 12px 20px;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            z-index: 10000;
            animation: slideIn 0.3s ease;
        }
        
        .status-message.success {
            background: #4bca81;
            color: white;
        }
        
        .status-message.error {
            background: #c23934;
            color: white;
        }
        
        .status-message.info {
            background: #0070d2;
            color: white;
        }
        
        @keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .response-title {
            display: block;
            margin-top: 20px;
            font-weight: 600;
            color: #16325c;
            font-size: 14px;
        }

        .response-table {
            margin-top: 20px;
        }

        .response-table table {
            width: 100%;
            border-collapse: collapse;
