            border: 1px solid #e5e5e5;
            padding: 8px 10px;
            text-align: left;
            vertical-align: top;
            word-break: break-word;
        }

        .response-table th:first-child,
        .response-table td:first-child {
            min-width: 180px;
        }

        .response-table th {
            background: #f3f6f9;
            font-weight: 600;
            color: #16325c;
        }
        
        .response-section label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            color: #16325c;
            font-size: 14px;
        }
        
        .response-section textarea {
            width: 100%;
            height: 450px;
            padding: 15px;
            border: 1px solid #d8dada;
            border-radius: 4px;
            background-color: #f9f9f9;
            font-family: 'Courier New', monospace;
            font-size: 12px;
