        .form-section {
            margin-bottom: 25px;
        }
        
        .form-section label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: #16325c;
            font-size: 13px;
        }
        
        .form-row {
            display: flex;
            gap: 30px;
            align-items: flex-start;
        }
        
        .form-left {
            flex: 1;
            min-width: 300px;
        }
        
        .form-right {
            flex: 1;
            min-width: 300px;
