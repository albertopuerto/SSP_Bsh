        .config-form {
            margin-top: 25px;
        }

        .config-form-header {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 16px;
        }

        .config-kb-title {
            font-size: 16px;
            font-weight: 600;
