        .config-form {
            margin-top: 25px;
        }

        .config-form-header {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 16px;
        }

        .config-kb-title {
            font-size: 16px;
            font-weight: 600;
            color: #16325c;
        }

        .config-group-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .config-group-pill {
            background: #f3f6f9;
            color: #16325c;
            border: 1px solid #d8dada;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 12px;
        }

        .config-form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
        }

        .config-field {
            background: #ffffff;
            border: 1px solid #e5e5e5;
            border-radius: 6px;
            padding: 12px;
        }

        .config-field.readonly {
            opacity: 0.7;
        }

        .config-field-title {
            font-weight: 600;
            color: #16325c;
            margin-bottom: 8px;
            font-size: 13px;
        }

        .required-indicator {
            color: #c23934;
            margin-left: 4px;
        }

        .config-field-options {
            display: flex;
            flex-direction: column;
            gap: 6px;
            font-size: 12px;
            color: #333;
        }

        .config-field .meta {
            margin-top: 6px;
            font-size: 11px;
            color: #706e6b;
        }
        
        .status-message {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 12px 20px;
            border-radius: 4px;
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            z-index: 10000;
            animation: slideIn 0.3s ease;
        }
        
        .status-message.success {
            background: #4bca81;
            color: white;
        }
        
        .status-message.error {
            background: #c23934;
            color: white;
        }
        
        .status-message.info {
            background: #0070d2;
            color: white;
        }
        
        @keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .response-title {
            display: block;
            margin-top: 20px;
            font-weight: 600;
            color: #16325c;
            font-size: 14px;
        }

        .response-table {
            margin-top: 20px;
        }

        .response-table table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border: 1px solid #e5e5e5;
            font-size: 12px;
        }

        .response-table th,
        .response-table td {
            border: 1px solid #e5e5e5;
            padding: 8px 10px;
            text-align: left;
            vertical-align: top;
            word-break: break-word;
        }

        .response-table th:first-child,
        .response-table td:first-child {
            min-width: 180px;
        }

        .response-table th {
            background: #f3f6f9;
            font-weight: 600;
            color: #16325c;
        }
        
        .response-section label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            color: #16325c;
            font-size: 14px;
        }
        
        .response-section textarea {
            width: 100%;
            height: 450px;
            padding: 15px;
            border: 1px solid #d8dada;
            border-radius: 4px;
            background-color: #f9f9f9;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            color: #333;
            line-height: 1.5;
            resize: none;
        }
        
        .endpoint-info {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
            padding: 15px;
            background-color: #f0f4ff;
            border-left: 3px solid #0070d2;
