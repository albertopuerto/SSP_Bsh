    function e2eInitForm() {
        const productCode = getUrlParam('productCode');
        const quoteId     = getUrlParam('SBQQ_QuoteId') || getUrlParam('quoteId') || getUrlParam('qId');

        // Initialize ETag fields
        const etagEl = document.getElementById('e2e-etag');
        const etagVersionEl = document.getElementById('e2e-etag-version');
        if (etagEl) etagEl.value = 'W/"1"';
        if (etagVersionEl) etagVersionEl.value = '1';

        // Initialize Quote ID
        const quoteIdEl = document.getElementById('e2e-quoteId');
        const quoteIdSourceEl = document.getElementById('e2e-quoteId-source');
        if (quoteId && quoteIdEl) {
            quoteIdEl.value = quoteId;
            if (quoteIdSourceEl) quoteIdSourceEl.textContent = '(from URL: SBQQ_QuoteId)';
        }

        // Initialize Product Key Mode - ALWAYS default to 'working' unless productCode explicitly provided
        const modeEl = document.getElementById('e2e-productKey-mode');
        if (modeEl) {
            const defaultMode = productCode ? 'context' : 'working';
            modeEl.value = defaultMode;
        }

        // Now apply the mode to fill in the product key input
        setTimeout(function() {
            e2eApplyProductKeyMode();
            e2eUpdatePreview();
        }, 0);

        if (quoteId || productCode) {
            e2eLog('Context loaded from URL — productCode: ' + (productCode || '—') + ', quoteId: ' + (quoteId || '—'), quoteId ? 'info' : 'warn');
        }

        // Attach change listeners
        ['e2e-kbId', 'e2e-productKey', 'e2e-date', 'e2e-autoCleanup'].forEach(function(id) {
            const el = document.getElementById(id);
            if (el) el.addEventListener('change', e2eUpdatePreview);
        });
