    function e2eLog(message, type) {
        const logEl = document.getElementById('e2e-log');
        if (!logEl) return;
        // Clear placeholder on first real entry
        if (logEl.querySelector('span[style]')) logEl.innerHTML = '';

        const colors = { call: '#5dade2', success: '#58d68d', warn: '#f39c12', error: '#ec7063', info: '#a9b7c6' };
        const color  = colors[type] || colors.info;
        const now    = new Date();
        const ts     = now.toTimeString().split(' ')[0];

        const line = document.createElement('div');
        line.style.color = color;
        line.textContent = '[' + ts + '] ' + message;
        logEl.appendChild(line);
        logEl.scrollTop = logEl.scrollHeight;
    }

    function e2eClearLog() {
        const logEl = document.getElementById('e2e-log');
        if (logEl) logEl.innerHTML = '<span style="color: #5d6d7e;">— Cleared —</span>';
    }

    function e2eErrorToString(error) {
        if (error === null || error === undefined) {
            return 'Unknown error';
        }
        if (typeof error === 'string') {
            return error;
        }
        if (error.message) {
            return error.message;
        }
        try {
            return JSON.stringify(error);
        } catch (e) {
            return String(error);
        }
    }

    function e2eExtractFriendlyError(errorText) {
        const raw = (errorText === null || errorText === undefined) ? '' : String(errorText);
        const normalized = raw.replace(/\\"/g, '"').replace(/\\n/g, '\n');

        const kbProfileMatch = normalized.match(/No knowledgebase profile for product[^"\n]+/);
        if (kbProfileMatch) {
            return kbProfileMatch[0];
        }

        const sapMessages = Array.from(normalized.matchAll(/"message"\s*:\s*"([^"]+)"/g)).map(function(match) {
            return match[1];
        }).filter(function(message) {
            return message && !message.startsWith('SAP VC Product Configuration API Error');
        });

        if (sapMessages.length > 0) {
            return sapMessages[0];
        }

        return raw;
    }

