    function buildKbDeterminationUrl(productId, validityDate, type, plant) {
        let url = '/api/v2/kbdetermination';
        const params = [];
        
        if (productId) params.push('productid=' + encodeURIComponent(productId));
        if (validityDate) params.push('date=' + encodeURIComponent(validityDate));
        
        const filterParts = [];
        if (type) filterParts.push("type EQ '" + type + "'");
        if (plant) filterParts.push("plant EQ '" + plant + "'");
        if (filterParts.length > 0) {
            params.push('$filter=' + encodeURIComponent(filterParts.join(' AND ')));
        }
        
        if (params.length > 0) {
            url += '?' + params.join('&');
        }
        
        return url;
    }
    
