        }
        
        .content-header h1 {
            margin: 0;
            font-size: 28px;
            color: #0070d2;
            font-weight: 600;
        }
        
        .content-body {
            flex: 1;
            overflow-y: auto;
            padding: 40px;
        }
        
        .tab-panel {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        
