    function e2eToast(message, type) {
        const container = document.getElementById('e2e-toast-container');
        if (!container || !message) {
            return;
        }

        const palette = {
            success: { background: '#e8f5e9', border: '#2e844a', color: '#16325c' },
            error: { background: '#fdeaea', border: '#c23934', color: '#8e2c21' },
            warn: { background: '#fff7e6', border: '#f39c12', color: '#7d4e00' },
            info: { background: '#eef4ff', border: '#5dade2', color: '#16325c' }
        };
        const style = palette[type] || palette.info;
        const toast = document.createElement('div');
        toast.style.pointerEvents = 'auto';
        toast.style.minWidth = '280px';
        toast.style.maxWidth = '420px';
        toast.style.padding = '12px 14px';
        toast.style.borderLeft = '5px solid ' + style.border;
        toast.style.borderRadius = '10px';
        toast.style.background = style.background;
        toast.style.color = style.color;
        toast.style.boxShadow = '0 12px 24px rgba(0,0,0,0.12)';
        toast.style.fontSize = '13px';
        toast.style.lineHeight = '1.45';
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-8px)';
        toast.style.transition = 'opacity 0.18s ease, transform 0.18s ease';
        toast.textContent = message;

        container.appendChild(toast);
        requestAnimationFrame(function() {
            toast.style.opacity = '1';
            toast.style.transform = 'translateY(0)';
        });

        setTimeout(function() {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(-8px)';
            setTimeout(function() {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 180);
        }, type === 'error' ? 5200 : 3400);
    }

