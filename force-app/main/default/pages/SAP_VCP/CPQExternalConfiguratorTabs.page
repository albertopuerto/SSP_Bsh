<script type="text/javascript">
//<![CDATA[
    
    if (typeof sforce !== 'undefined' && sforce.connection) {
        sforce.connection.sessionId = '{!$Api.Session_ID}';
        sforce.connection.serverUrl = '{!$Api.Partner_Server_URL_570}';
    }

    function getUrlParam(name) {
        const searchValue = new URLSearchParams(window.location.search).get(name);
        if (searchValue) {
            return searchValue;
        }

        // CPQ frequently puts route/query data in the hash fragment.
        const hash = window.location.hash || '';
        const queryIndex = hash.indexOf('?');
        if (queryIndex === -1) {
            return null;
        }

        const hashQuery = hash.substring(queryIndex + 1);
        return new URLSearchParams(hashQuery).get(name);
    }

    function resolveAndDisplayProductCode(quoteLineId, productId, sourceLabel) {
        if (!quoteLineId && !productId) {
            return;
        }

        if (typeof sforce === 'undefined' || !sforce.apex || !sforce.apex.execute) {
            console.warn('Could not resolve ProductCode: sforce.apex.execute is not available');
            return;
        }

        try {
            const code = sforce.apex.execute(
                'CPQExternalConfiguratorController',
                'resolveProductCodeFromContext',
                { quoteLineId: quoteLineId || '', productId: productId || '' }
            );

            const resolved = Array.isArray(code) ? code[0] : code;

            if (resolved) {
                document.getElementById('cpq-product-code').textContent = resolved;
                document.getElementById('cpq-context-raw').textContent =
                    '(source=' + (sourceLabel || 'unknown') + ', quoteLineId=' + (quoteLineId || '-') + ', productId=' + (productId || '-') + ')';
                document.getElementById('cpq-context-bar').style.display = 'block';
            }
