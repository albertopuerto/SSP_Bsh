            white-space: nowrap;
        }
        
        .cheatsheet-value {
            font-family: 'Courier New', monospace;
            font-size: 13px;
            color: #0070d2;
            font-weight: 500;
            word-break: break-all;
        }
        
        .cheatsheet-notes {
            font-size: 12px;
            color: #706e6b;
            font-style: italic;
            line-height: 1.5;
        }
        
        .cheatsheet-notes strong {
            color: #16325c;
            font-style: normal;
        }
        
        .cheatsheet-list {
            background: #f9f9f9;
            padding: 20px;
            border-radius: 6px;
            border: 1px solid #e5e5e5;
            margin: 0;
        }
        
        .cheatsheet-list-item {
            font-family: 'Courier New', monospace;
            font-size: 13px;
            color: #16325c;
            padding: 6px 0;
            border-bottom: 1px solid #e5e5e5;
        }
        
        .cheatsheet-list-item:last-child {
