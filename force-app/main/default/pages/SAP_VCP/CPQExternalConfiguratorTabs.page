    function e2eEnsureFormInitialized() {
        // This ensures that even if the accordion was closed during DOMContentLoaded,
        // the form gets properly initialized when opened
        const modeEl = document.getElementById('e2e-productKey-mode');
        const inputEl = document.getElementById('e2e-productKey');
        
        if (!modeEl || !inputEl) return;
        
        // Only initialize if values are empty
        if (!modeEl.value || modeEl.value === '') {
            const productCode = getUrlParam('productCode');
            const defaultMode = productCode ? 'context' : 'working';
            modeEl.value = defaultMode;
