        .preview-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #16325c;
            font-size: 13px;
        }
        
        .preview-box {
            background-color: #f9f9f9;
            border: 1px solid #d8dada;
            border-radius: 4px;
            padding: 15px;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            color: #333;
            line-height: 1.5;
            max-height: 400px;
            overflow-y: auto;
            white-space: pre-wrap;
            word-break: break-word;
        }
        
        .form-section input,
        .form-section textarea {
            width: 100%;
            max-width: 600px;
            padding: 10px 12px;
            border: 1px solid #d8dada;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            transition: border-color 0.15s ease;
        }
        
        .form-section textarea {
            resize: vertical;
            min-height: 100px;
            font-family: 'Courier New', monospace;
        }
        
        .form-section input:focus,
        .form-section textarea:focus {
            outline: none;
