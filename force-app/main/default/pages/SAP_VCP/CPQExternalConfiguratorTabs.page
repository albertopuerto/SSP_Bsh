    function callAPI(endpoint) {
        let method, params = {}, outputId;
        
        switch(endpoint) {
            case 'determine':
                method = 'determineKnowledgebase';
                params = { 
                    productId: document.getElementById('determine-productId').value,
                    validityDate: document.getElementById('determine-validityDate').value,
                    type: document.getElementById('determine-type').value,
                    plant: document.getElementById('determine-plant').value
                };
                outputId = 'output-determine';
                break;
            case 'get-kb':
                method = 'getKnowledgebaseById';
                params = { kbId: document.getElementById('input-kbid').value };
                outputId = 'output-get-kb';
                break;
            case 'get-translations':
                method = 'getKnowledgebaseTranslations';
                params = { 
                    kbId: document.getElementById('input-kb-trans-id').value,
                    language: document.getElementById('input-kb-trans-language').value
                };
                outputId = 'output-get-translations';
                break;
            case 'create':
                method = 'createConfigurationV2';
                const payload = buildConfigurationPayload();
                params = { configData: JSON.stringify(payload) };
                outputId = 'output-create';
                break;
            case 'patch':
                method = 'patchConfigurationV2';
                params = { 
                    configId: document.getElementById('input-patch-id').value,
                    patchData: document.getElementById('input-patch').value
                };
                outputId = 'output-patch';
                break;
            case 'get':
                method = 'getConfigurationV2';
                params = { configId: document.getElementById('input-get-id').value };
                outputId = 'output-get';
                break;
            case 'pricing':
                method = 'callPricingService';
                params = { pricingData: document.getElementById('input-pricing').value };
                outputId = 'output-pricing';
                break;
            case 'delete':
                method = 'completeConfigurationV2';
                params = { configId: document.getElementById('input-delete-id').value };
                outputId = 'output-delete';
                break;
            case 'cfg-delete-v2':
                method = 'deleteConfigurationV2';
                params = { configId: document.getElementById('input-more-config-id').value };
                outputId = 'output-more-apis';
                break;
            case 'cfg-complete-v2':
                method = 'completeConfigurationV2';
                params = { configId: document.getElementById('input-more-config-id').value };
                outputId = 'output-more-apis';
                break;
            case 'cfg-lock-v2':
                method = 'lockConfigurationV2';
                params = {
                    configId: document.getElementById('input-more-config-id').value,
                    lockBody: document.getElementById('input-more-lock-body').value
                };
                outputId = 'output-more-apis';
                break;
            case 'cfg-reset-v2':
                method = 'resetConfigurationV2';
                params = { configId: document.getElementById('input-more-config-id').value };
                outputId = 'output-more-apis';
                break;
            case 'cfg-patch-item-v2':
                method = 'patchConfigurationItemV2';
                params = {
                    configId: document.getElementById('input-more-config-id').value,
                    itemId: document.getElementById('input-more-item-id').value,
                    itemPatchData: document.getElementById('input-more-item-patch-body').value
                };
                outputId = 'output-more-apis';
                break;
            case 'cfg-get-item-characteristics-v2':
                method = 'getItemCharacteristicsV2';
                params = {
                    configId: document.getElementById('input-more-config-id').value,
                    itemId: document.getElementById('input-more-item-id').value,
                    filter: document.getElementById('input-more-item-filter').value
                };
                outputId = 'output-more-apis';
                break;
            case 'cfg-get-external-list-v2':
                method = 'getExternalConfigurationsV2';
                params = {};
                outputId = 'output-more-apis';
                break;
            case 'cfg-load-external-v2':
                method = 'loadExternalConfigurationV2';
                params = {
                    body: document.getElementById('input-more-load-ext-body').value,
                    sourceConfigurationId: document.getElementById('input-more-source-config-id').value,
                    selectValue: document.getElementById('input-more-select').value
                };
                outputId = 'output-more-apis';
                break;
            case 'cfg-get-external-by-id-v2':
                method = 'getExternalConfigurationByIdV2';
                params = { configId: document.getElementById('input-more-ext-config-id').value };
                outputId = 'output-more-apis';
                break;
            case 'cfg-get-external-display-by-id-v2':
                method = 'getExternalConfigurationDisplayByIdV2';
                params = { configId: document.getElementById('input-more-ext-config-id').value };
                outputId = 'output-more-apis';
                break;
            case 'cfg-kb-metrics-v2':
                method = 'getKnowledgebaseMetrics';
                params = { kbId: document.getElementById('input-more-kb-id').value };
                outputId = 'output-more-apis';
                break;
            case 'cfg-kb-dependency-v2':
                method = 'getKnowledgebaseDependencyById';
                params = {
                    kbId: document.getElementById('input-more-kb-id').value,
                    dependencyId: document.getElementById('input-more-dependency-id').value
                };
                outputId = 'output-more-apis';
                break;
            case 'cfg-kb-variant-table-v2':
                method = 'getKnowledgebaseVariantTableById';
                params = {
                    kbId: document.getElementById('input-more-kb-id').value,
                    variantTableId: document.getElementById('input-more-variant-table-id').value,
                    language: document.getElementById('input-more-vt-language').value,
                    top: document.getElementById('input-more-vt-top').value,
                    skip: document.getElementById('input-more-vt-skip').value
                };
                outputId = 'output-more-apis';
                break;
        }
        
        try {
            const textarea = document.getElementById(outputId);
            textarea.value = 'Loading...';
            const tableId = outputId ? outputId.replace('output-', 'table-') : null;
            if (tableId) {
                clearTable(tableId);
            }
            
            const result = sforce.apex.execute('CPQExternalConfiguratorController', method, params);
            
            let formatted = '';
            try {
                const parsed = JSON.parse(result);
                formatted = JSON.stringify(parsed, null, 2);
                if (tableId) {
                    renderTable(parsed, tableId);
                }
                if (endpoint === 'get') {
                    renderConfigurationForm(parsed, 'config-form-container', { editable: false, storeOriginal: false });
                } else {
                    clearConfigurationForm('config-form-container');
                }
            } catch (e) {
                formatted = result;
                if (tableId) {
                    clearTable(tableId);
                }
                clearConfigurationForm('config-form-container');
            }
            
            textarea.value = formatted;
            
        } catch (error) {
            document.getElementById(outputId).value = 'Error: ' + error.message;
            const tableId = outputId ? outputId.replace('output-', 'table-') : null;
            if (tableId) {
                clearTable(tableId);
            }
            clearConfigurationForm('config-form-container');
        }
    }

