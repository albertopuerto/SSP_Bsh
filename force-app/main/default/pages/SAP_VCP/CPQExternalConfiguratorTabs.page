    function updateConfigurationEditor() {
        const textarea = document.getElementById('output-config-editor');
        const tableId = 'table-config-editor';
        const configId = document.getElementById('input-config-editor-id').value || configEditorLastId;
        const etagInput = document.getElementById('input-config-etag');

        if (!configId) {
            textarea.value = 'Please provide a Configuration ID.';
            showStatusMessage('Please provide a Configuration ID', 'error');
            return;
        }

        // Validate that configuration is loaded
        if (!configEditorCurrentConfig) {
            textarea.value = 'Configuration not loaded. Please click "Load Configuration" first.';
            showStatusMessage('Configuration not loaded', 'error');
            return;
        }

        // Get ETag: Priority: input field > config._eTag > config variable > default W/"1"
        let etag = (etagInput && etagInput.value) ? etagInput.value : null;
        if (!etag) {
            etag = configEditorCurrentConfig._eTag || configEditorCurrentETag || 'W/"1"';
        }
        
        console.log('=== Checking ETag ===');
        console.log('=== ETag from input field:', (etagInput && etagInput.value));
        console.log('=== configEditorCurrentConfig._eTag:', configEditorCurrentConfig._eTag);
        console.log('=== configEditorCurrentETag:', configEditorCurrentETag);
        console.log('=== resolved etag:', etag);
        console.log('=== All keys in configEditorCurrentConfig:', Object.keys(configEditorCurrentConfig));
        
        showStatusMessage('Using ETag: ' + etag, 'info', 3000);

        const patchOps = buildPatchOperationsFromEditor();
        if (!patchOps) {
            textarea.value = 'No changes detected.';
            showStatusMessage('No changes detected', 'info');
            return;
        }

        try {
            showStatusMessage('Updating configuration...', 'info');
            textarea.value = 'Updating...';
            clearTable(tableId);
            
            console.log('=== updateConfigurationEditor ===');
            console.log('=== Config ID:', configId);
            console.log('=== ETag:', etag);
            console.log('=== Current Config:', configEditorCurrentConfig);
            console.log('=== PATCH Operations to send:', JSON.stringify(patchOps, null, 2));
            
            let patchResult = sforce.apex.execute(
                'CPQExternalConfiguratorController',
                'patchConfigurationCharacteristics',
                { 
                    configId: configId, 
                    etag: etag,
                    patchOperations: JSON.stringify(patchOps) 
                }
            );

            console.log('=== Apex response received:', patchResult);
            
            // Handle if sforce.apex.execute returns an array with the response inside
            if (Array.isArray(patchResult) && patchResult.length > 0) {
                patchResult = patchResult[0];
                console.log('=== Extracted patchResult from array:', patchResult);
            }

            if (!patchResult) {
                textarea.value = 'Error: No response from PATCH operation';
                showStatusMessage('No response from PATCH operation', 'error');
                return;
            }

            let formatted = '';
            try {
                const parsedPatch = JSON.parse(patchResult);
                formatted = JSON.stringify(parsedPatch, null, 2);
                renderTable(parsedPatch, tableId);
                
                // Check if PATCH was successful
                if (parsedPatch.success === true) {
                    showStatusMessage('Configuration updated successfully. Capturing ETag and reloading...', 'success', 3000);
                    
                    // Try to capture ETag from PATCH response
                    if (parsedPatch.latestETag) {
                        console.log('=== New ETag captured from PATCH response:', parsedPatch.latestETag);
                        configEditorCurrentETag = parsedPatch.latestETag;
                        document.getElementById('input-config-etag').value = parsedPatch.latestETag;
                    } else if (parsedPatch.results) {
                        const firstResult = Object.values(parsedPatch.results)[0];
                        if (firstResult && firstResult.eTag) {
                            const newETag = firstResult.eTag;
                            console.log('=== New ETag captured from first result:', newETag);
                            configEditorCurrentETag = newETag;
                            document.getElementById('input-config-etag').value = newETag;
                        }
                    }
                    
                    // Auto-reload configuration to get updated values and latest ETag
                    setTimeout(function() {
                        console.log('=== Auto-reloading configuration after successful PATCH ===');
                        loadConfigurationEditor();
                    }, 1500);
                } else if (parsedPatch.success === false) {
                    // PATCH failed - show error details
                    let errorMsg = 'PATCH failed: ';
                    if (parsedPatch.results) {
                        const resultKeys = Object.keys(parsedPatch.results);
                        for (const key of resultKeys) {
                            const result = parsedPatch.results[key];
                            if (result.error) {
                                errorMsg += key + ' - ' + (typeof result.error === 'string' ? JSON.parse(result.error).message : result.error.message) + '; ';
                            }
                        }
                    }
                    showStatusMessage(errorMsg, 'error', 7000);
                } else {
                    showStatusMessage('Configuration update completed.', 'info', 5000);
                }
            } catch (e) {
                formatted = patchResult;
                renderTable(patchResult, tableId);
                showStatusMessage('Configuration update completed. Reloading...', 'info', 3000);
                setTimeout(function() {
                    loadConfigurationEditor();
                }, 1500);
            }
            
            textarea.value = formatted;
        } catch (error) {
            const errorMsg = error && error.message ? error.message : String(error);
            textarea.value = 'Error: ' + errorMsg;
            console.error('Update Configuration Error:', error);
            console.error('Patch operations attempted:', patchOps);
            showStatusMessage('Error updating configuration', 'error', 5000);
        }
    }

    function executePricingRequest(apexMethod, params, tableId, outputId, onSuccess) {
        const textarea = document.getElementById(outputId);
        clearTable(tableId);
        textarea.value = 'Processing...';
        showStatusMessage('Processing pricing request...', 'info');

        try {
            let result = sforce.apex.execute('CPQExternalConfiguratorController', apexMethod, params);
            if (Array.isArray(result) && result.length > 0) {
                result = result[0];
            }

            if (!result) {
                textarea.value = 'Error: No response from server';
                showStatusMessage('No response from server', 'error');
                return;
            }

            try {
                const parsed = JSON.parse(result);
                textarea.value = JSON.stringify(parsed, null, 2);
                renderTable(parsed, tableId);
                if (onSuccess) {
                    onSuccess(parsed);
                }
            } catch (e) {
                textarea.value = result;
                renderTable(result, tableId);
            }
        } catch (error) {
            const errorMsg = error && error.message ? error.message : String(error);
            textarea.value = 'Error: ' + errorMsg;
            console.error('Pricing Request Error:', error);
            showStatusMessage('Pricing request failed', 'error', 5000);
        }
    }

    function extractPricingDocumentId(parsed) {
        if (!parsed) {
            return null;
        }
        if (parsed.documentId) {
            return parsed.documentId;
        }
        if (parsed.id) {
            return parsed.id;
        }
        if (parsed.document && parsed.document.documentId) {
            return parsed.document.documentId;
        }
        if (parsed.document && parsed.document.id) {
            return parsed.document.id;
        }
        if (parsed.documentHeader && parsed.documentHeader.documentId) {
            return parsed.documentHeader.documentId;
        }
        if (parsed.header && parsed.header.documentId) {
            return parsed.header.documentId;
        }
        return null;
    }

    // Helper function to remove empty values from objects recursively
    function removeEmpty(obj) {
        if (typeof obj !== 'object' || obj === null) {
            return obj;
        }
        
        if (Array.isArray(obj)) {
            return obj.map(removeEmpty).filter(item => {
                if (typeof item === 'object' && item !== null) {
                    return Object.keys(item).length > 0;
                }
                return item !== '' && item !== null && item !== undefined;
            });
        }
        
        return Object.keys(obj).reduce((result, key) => {
            const value = obj[key];
            const cleaned = removeEmpty(value);
            
            // Only include if not empty
            if (cleaned !== '' && cleaned !== null && cleaned !== undefined) {
                // For nested objects, only include if has properties
                if (typeof cleaned === 'object' && !Array.isArray(cleaned)) {
                    if (Object.keys(cleaned).length > 0) {
                        result[key] = cleaned;
                    }
                } else if (Array.isArray(cleaned)) {
                    if (cleaned.length > 0) {
                        result[key] = cleaned;
                    }
                } else {
                    result[key] = cleaned;
                }
            }
            return result;
        }, {});
    }

