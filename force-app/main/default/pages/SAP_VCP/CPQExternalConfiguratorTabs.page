        }
        
        .assumption-title {
            font-weight: 600;
            color: #16325c;
            margin: 0 0 8px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .assumption-title::before {
            content: "⚠️";
            font-size: 16px;
        }
        
        .assumption-description {
            color: #706e6b;
            font-size: 13px;
            line-height: 1.6;
            margin: 0;
        }
        
        .assumption-code {
            font-family: 'Courier New', monospace;
