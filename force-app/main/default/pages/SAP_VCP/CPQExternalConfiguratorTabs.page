    function renderTable(data, tableId) {
        const container = document.getElementById(tableId);
        if (!container) {
            return;
        }

        container.innerHTML = '';

        if (data === null || data === undefined) {
            return;
        }

        const table = document.createElement('table');
        const thead = document.createElement('thead');
        const tbody = document.createElement('tbody');

        if (Array.isArray(data)) {
            if (data.length === 0) {
                return;
            }

            const firstRow = data[0] && typeof data[0] === 'object' ? data[0] : { value: data[0] };
            const headers = Object.keys(firstRow);

            const headerRow = document.createElement('tr');
            headers.forEach((key) => {
                const th = document.createElement('th');
                th.textContent = key;
                headerRow.appendChild(th);
            });
            thead.appendChild(headerRow);

            data.forEach((row) => {
                const tr = document.createElement('tr');
                const rowData = row && typeof row === 'object' ? row : { value: row };
                headers.forEach((key) => {
                    const td = document.createElement('td');
                    const value = rowData[key];
                    td.textContent = typeof value === 'object' ? JSON.stringify(value) : String(value ?? '');
                    tr.appendChild(td);
                });
                tbody.appendChild(tr);
            });
        } else if (typeof data === 'object') {
            const headerRow = document.createElement('tr');
            const keyHeader = document.createElement('th');
            keyHeader.textContent = 'Field';
            const valueHeader = document.createElement('th');
            valueHeader.textContent = 'Value';
            headerRow.appendChild(keyHeader);
            headerRow.appendChild(valueHeader);
            thead.appendChild(headerRow);

            Object.keys(data).forEach((key) => {
                const tr = document.createElement('tr');
                const tdKey = document.createElement('td');
                tdKey.textContent = key;
                const tdValue = document.createElement('td');
                const value = data[key];
                tdValue.textContent = typeof value === 'object' ? JSON.stringify(value) : String(value ?? '');
                tr.appendChild(tdKey);
                tr.appendChild(tdValue);
                tbody.appendChild(tr);
            });
        } else {
            const headerRow = document.createElement('tr');
            const keyHeader = document.createElement('th');
            keyHeader.textContent = 'Value';
            headerRow.appendChild(keyHeader);
            thead.appendChild(headerRow);

            const tr = document.createElement('tr');
            const td = document.createElement('td');
            td.textContent = String(data);
            tr.appendChild(td);
            tbody.appendChild(tr);
        }

        table.appendChild(thead);
        table.appendChild(tbody);
        container.appendChild(table);
    }

    function clearConfigurationForm(containerId) {
