    function e2eGetBestTranslationName(translations, language) {
        if (!Array.isArray(translations) || translations.length === 0) {
            return null;
        }

        if (language) {
            const exact = translations.find(function(item) {
                return item && item.language === language && item.name;
            });
            if (exact) {
                return exact.name;
            }
            return null;
        }

        const firstWithName = translations.find(function(item) {
            return item && item.name;
        });
        return firstWithName ? firstWithName.name : null;
    }

    function e2eHasUsableTranslations(index) {
        if (!index || typeof index !== 'object') {
            return false;
        }

        if (Object.keys(index.characteristics || {}).length > 0) {
            return true;
        }

        if (Object.keys(index.products || {}).length > 0) {
            return true;
        }

        if (Object.keys(index.groups || {}).length > 0) {
            return true;
        }

        const valuesMap = index.values || {};
        return Object.keys(valuesMap).some(function(characteristicId) {
            return Object.keys(valuesMap[characteristicId] || {}).length > 0;
        });
    }

    function e2eBuildTranslationIndex(payload, language, productKey) {
        const index = {
            language: language,
            productKey: productKey || '',
            products: {},
            characteristics: {},
            values: {},
            groups: {}
        };

        if (!payload || typeof payload !== 'object') {
            return index;
        }

        if (Array.isArray(payload.characteristics)) {
            payload.characteristics.forEach(function(item) {
                if (!item || !item.id) {
                    return;
                }

                const characteristicName = e2eGetBestTranslationName(item.translation, language);
                if (characteristicName) {
                    index.characteristics[item.id] = characteristicName;
                }

                if (Array.isArray(item.possibleValues) && item.possibleValues.length > 0) {
                    index.values[item.id] = index.values[item.id] || {};
                    item.possibleValues.forEach(function(valueItem) {
                        if (!valueItem || valueItem.id === undefined || valueItem.id === null) {
                            return;
                        }
                        const valueName = e2eGetBestTranslationName(valueItem.translation, language);
                        if (valueName) {
                            index.values[item.id][String(valueItem.id)] = valueName;
                        }
                    });
                }
            });
        }

        if (Array.isArray(payload.products)) {
            const bestProduct = payload.products.find(function(product) {
                return product && product.id && productKey && product.id === productKey;
            }) || payload.products[0];

            if (bestProduct && bestProduct.id) {
                const productName = e2eGetBestTranslationName(bestProduct.translation, language);
                if (productName) {
                    index.products[bestProduct.id] = productName;
                }
            }

            if (bestProduct && Array.isArray(bestProduct.characteristicGroups)) {
                bestProduct.characteristicGroups.forEach(function(group) {
                    if (!group || !group.id) {
                        return;
                    }
                    const groupName = e2eGetBestTranslationName(group.translation, language);
                    if (groupName) {
                        index.groups[group.id] = groupName;
                    }
                });
            }
        }

        return index;
    }

    function e2eToggleLangDropdown() {
        const opts = document.getElementById('e2e-lang-options');
        if (opts) {
            opts.style.display = opts.style.display === 'none' ? 'block' : 'none';
        }
    }

    function e2eLangResetToApi() {
        document.getElementById('e2e-label-mode').value = 'api';
        const labelEl = document.getElementById('e2e-lang-label');
        if (labelEl) {
            labelEl.textContent = 'API IDs';
        }
        const flagWrap = document.getElementById('e2e-lang-flag-wrap');
        if (flagWrap) {
            flagWrap.textContent = '🤖';
        }
    }

    function e2eLangSelect(value, label, emoji, flagUrl) {
        const select = document.getElementById('e2e-label-mode');
        if (select) {
            select.value = value;
        }
        const labelEl = document.getElementById('e2e-lang-label');
        if (labelEl) {
