    function e2eApplyLabelModeChange() {
        const mode = document.getElementById('e2e-label-mode').value;
        if (mode === 'api') {
            e2eTranslationIndex = null;
            e2eRenderLoadedConfiguration();
            e2eLog('Display labels set to API IDs', 'info');
            return;
        }

        e2eLoadTranslationsForLanguage(mode);
    }

    function e2eLoadTranslationsForLanguage(language) {
        if (!e2eLoadedConfig) {
            e2eToast('Load configuration first to apply translations.', 'warn');
            return;
        }

        const kbId = document.getElementById('e2e-kbId').value;
        const productKey = (e2eLoadedConfig && (e2eLoadedConfig.productKey || (e2eLoadedConfig.rootItem && e2eLoadedConfig.rootItem.key))) || '';
        const cacheKey = String(kbId || '') + '::' + String(productKey || '') + '::' + String(language || '');

        if (e2eTranslationCache[cacheKey]) {
            const cachedIndex = e2eTranslationCache[cacheKey];
            if (!e2eHasUsableTranslations(cachedIndex)) {
                e2eTranslationIndex = null;
                e2eLangResetToApi();
                e2eRenderLoadedConfiguration();
                e2eLog('⚠️ no translations found in cache for language ' + language + '; reverted to API labels', 'warn');
                e2eToast('No translations for ' + language + '. Reverted to API labels.', 'warn');
                return;
            }

            e2eTranslationIndex = cachedIndex;
            e2eRenderLoadedConfiguration();
            e2eLog('Translations loaded from cache | kbId: ' + kbId + ' | language: ' + language, 'info');
            return;
        }

        e2eLog('→ getKnowledgebaseTranslations | kbId: ' + kbId + ' | language: ' + language, 'call');

        try {
            let result = sforce.apex.execute('CPQExternalConfiguratorController', 'getKnowledgebaseTranslations', {
                kbId: kbId,
                language: language
            });

            if (Array.isArray(result) && result.length > 0) {
                result = result[0];
            }

            const parsed = JSON.parse(result);
            const index = e2eBuildTranslationIndex(parsed, language, productKey);

            if (!e2eHasUsableTranslations(index)) {
                e2eTranslationCache[cacheKey] = index;
                e2eTranslationIndex = null;
                e2eLangResetToApi();
                e2eRenderLoadedConfiguration();
                e2eLog('⚠️ no translations returned for language ' + language + '; reverted to API labels', 'warn');
                e2eToast('No translations for ' + language + '. Reverted to API labels.', 'warn');
                return;
            }

            e2eTranslationCache[cacheKey] = index;
            e2eTranslationIndex = index;
            e2eRenderLoadedConfiguration();
            e2eLog('✅ translations loaded and indexed | characteristic labels: ' + Object.keys(index.characteristics).length, 'success');
            e2eToast('Translations applied (' + language + ').', 'success');
        } catch (error) {
            const errorText = e2eErrorToString(error);
            e2eLog('❌ getKnowledgebaseTranslations ERROR: ' + errorText, 'error');
            e2eToast('Translations load failed: ' + e2eExtractFriendlyError(errorText), 'error');
            e2eTranslationIndex = null;
            e2eLangResetToApi();
            e2eRenderLoadedConfiguration();
        }
    }

    function e2eUpdateConfigSummary(config) {
        const summaryEl = document.getElementById('e2e-config-summary');
        if (!summaryEl) {
            return;
        }
        if (!config || !config.rootItem || !Array.isArray(config.rootItem.characteristics)) {
            summaryEl.textContent = 'No configuration loaded yet';
            return;
        }

        const characteristics = config.rootItem.characteristics;
        const visibleCount = characteristics.filter(function(ch) { return ch.visible !== false; }).length;
        const hiddenCount = characteristics.length - visibleCount;
        const readonlyCount = characteristics.filter(function(ch) { return ch.readOnly === true; }).length;
        const requiredCount = characteristics.filter(function(ch) { return ch.required === true; }).length;

        summaryEl.textContent = 'Total: ' + characteristics.length
            + ' | Visible: ' + visibleCount
            + ' | Hidden/dependent: ' + hiddenCount
            + ' | Readonly: ' + readonlyCount
            + ' | Required: ' + requiredCount;
    }

    function e2eRenderLoadedConfiguration() {
        const mode = document.getElementById('e2e-field-visibility-mode').value;
        const groupMode = document.getElementById('e2e-group-mode').value;
        const labelMode = document.getElementById('e2e-label-mode').value;
        if (!e2eLoadedConfig) {
            clearConfigurationForm('e2e-config-container');
            e2eUpdateConfigSummary(null);
            return;
        }

        renderConfigurationForm(e2eLoadedConfig, 'e2e-config-container', {
            editable: true,
            storeOriginal: Object.keys(e2eEditorOriginalValues).length === 0,
            showHidden: mode === 'all',
            groupMode: groupMode,
            labelMode: labelMode,
            translationIndex: labelMode === 'api' ? null : e2eTranslationIndex,
            originalValuesStore: e2eEditorOriginalValues,
            characteristicIndexMap: e2eEditorCharacteristicIndexMap,
            onChange: e2eBuildPatchPreview
        });
        e2eUpdateConfigSummary(e2eLoadedConfig);
        e2eBuildPatchPreview();
        e2eLog('Rendered configuration in mode: ' + mode, 'info');
    }

    function e2eBuildPatchPreview() {
        return buildPatchOperationsFromContainer(
            'e2e-config-container',
            e2eEditorCurrentConfig,
            e2eEditorOriginalValues,
            'e2e-patch-preview'
        );
    }

    function e2eReloadRuntimeConfig() {
        const configId = e2eEditorLastId || document.getElementById('e2e-stored-config-id').value || document.getElementById('e2e-captured-config-id').textContent;
        if (!configId) {
            e2eLog('⚠️ reload skipped: no configId available', 'warn');
            return;
        }
        e2eLog('→ reload runtime configuration | configId: ' + configId, 'call');
        e2eLoadConfigurationById(configId);
    }

    function e2eApplyPatch() {
        const outputEl = document.getElementById('output-e2e-load');
        const configId = e2eEditorLastId || document.getElementById('e2e-stored-config-id').value || document.getElementById('e2e-captured-config-id').textContent;
        let etag = document.getElementById('e2e-etag').value;

        if (!configId) {
            outputEl.value = 'Please provide a Configuration ID.';
            e2eLog('❌ apply patch aborted: no configId available', 'error');
            e2eToast('Patch aborted: no configuration ID available.', 'error');
            return;
        }
        if (!e2eEditorCurrentConfig) {
            outputEl.value = 'Configuration not loaded.';
            e2eLog('❌ apply patch aborted: configuration not loaded', 'error');
            e2eToast('Patch aborted: configuration not loaded.', 'error');
            return;
        }
        if (!etag) {
            etag = e2eEditorCurrentConfig._eTag || e2eEditorCurrentETag || 'W/"1"';
            document.getElementById('e2e-etag').value = etag;
        }

        const patchOps = e2eBuildPatchPreview();
        if (!patchOps) {
            outputEl.value = 'No changes detected.';
            e2eLog('ℹ️ apply patch skipped: no changes detected', 'info');
            e2eToast('No changes detected for patch.', 'info');
            return;
        }

        outputEl.value = 'Updating...';
        e2eLog('→ patchConfigurationCharacteristics | configId: ' + configId + ' | etag: ' + etag + ' | operations: ' + patchOps.length, 'call');

        try {
            let patchResult = sforce.apex.execute('CPQExternalConfiguratorController', 'patchConfigurationCharacteristics', {
                configId: configId,
                etag: etag,
                patchOperations: JSON.stringify(patchOps)
            });

            if (Array.isArray(patchResult) && patchResult.length > 0) {
                patchResult = patchResult[0];
            }

            const parsedPatch = JSON.parse(patchResult);
            outputEl.value = JSON.stringify(parsedPatch, null, 2);

            if (parsedPatch.latestETag) {
                e2eEditorCurrentETag = parsedPatch.latestETag;
                document.getElementById('e2e-etag').value = parsedPatch.latestETag;
                e2eSyncETagPreset(parsedPatch.latestETag);
                e2eLog('ETag updated from patch result: ' + parsedPatch.latestETag, 'info');
            }

            if (parsedPatch.success === true) {
                e2eLog('✅ patchConfigurationCharacteristics OK | reloading configuration', 'success');
                e2eToast('Patch applied successfully. Reloading configuration...', 'success');
                setTimeout(function() {
                    e2eReloadRuntimeConfig();
                }, 1000);
            } else {
                const successCount = parsedPatch.successCount || 0;
                const totalCount = parsedPatch.totalCount || 0;
                e2eLog('⚠️ patchConfigurationCharacteristics partial result: ' + successCount + '/' + totalCount + ' succeeded', 'warn');
                e2eToast('Patch partial result: ' + successCount + '/' + totalCount + ' operations succeeded.', 'warn');

                if (successCount > 0) {
                    e2eLog('↻ reloading after partial success to recalculate visibility/dependencies', 'info');
                    setTimeout(function() {
                        e2eReloadRuntimeConfig();
                    }, 1000);
                }
            }
        } catch (error) {
            const errorText = e2eErrorToString(error);
            outputEl.value = 'Error: ' + errorText;
            e2eLog('❌ patchConfigurationCharacteristics ERROR: ' + errorText, 'error');
            e2eToast('Patch failed: ' + e2eExtractFriendlyError(errorText), 'error');
        }
    }

    function e2eResetFlow() {
        e2eSetInitialFlowCollapsed(false);
        e2eSetCreateStageHidden(false);
        e2eSetSimulateControlsHidden(false);
        e2eSetRuntimeVisible(false);
        document.getElementById('e2e-save-section').style.display = 'none';
        document.getElementById('e2e-save-status').textContent = '';
        document.getElementById('e2e-save-message').textContent = '';
        document.getElementById('e2e-save-message').style.display = 'none';
        document.getElementById('e2e-toggle-create-stage').style.display = 'none';
        document.getElementById('e2e-field-visibility-mode').value = 'visible';
        document.getElementById('e2e-group-mode').value = 'flat';
        e2eLangResetToApi();
        document.getElementById('e2e-etag').value = 'W/"1"';
        document.getElementById('e2e-etag-version').value = '1';
        document.getElementById('e2e-config-summary').textContent = 'No configuration loaded yet';
        document.getElementById('e2e-patch-preview').textContent = 'No changes detected';
        document.getElementById('output-e2e-load').value = '';
        clearConfigurationForm('e2e-config-container');
        e2eLoadedConfig = null;
        e2eEditorCurrentConfig = null;
        e2eEditorCurrentETag = null;
        e2eEditorLastId = null;
        e2eEditorOriginalValues = {};
        e2eEditorCharacteristicIndexMap = {};
        e2eTranslationIndex = null;
        e2eLog('Flow reset to initial state', 'info');
        e2eToast('End to End flow reset.', 'info');
    }

    function e2eRestartAndPrepareNewConfig() {
        const quoteId = document.getElementById('e2e-quoteId').value;

        e2eResetFlow();

        // Force Product Key Mode to 'working' (F00K001001)
        const modeEl = document.getElementById('e2e-productKey-mode');
        if (modeEl) {
            modeEl.value = 'working';
        }

        if (quoteId) {
            e2eClearConfigIdFromQuote();
            e2eLog('↺ Restarted flow and cleared stored Config ID to allow regeneration', 'info');
        } else {
            document.getElementById('e2e-stored-config-id').value = '';
            document.getElementById('e2e-captured-config-id').textContent = '';
            e2eLog('↺ Restarted flow without quote context; ready to create a new configuration', 'info');
        }

        // Auto-trigger create with the current payload
        setTimeout(function() {
            // Apply the product key mode to fill in F00K001001
            e2eApplyProductKeyMode();
            e2eUpdatePreview();
            e2eLog('→ auto-creating new configuration after restart with F00K001001', 'info');
            e2eCreateConfig();
        }, 300);
    }

    function e2eCreateConfig() {
        const payload = e2eGetCreatePayload();
        const productKey = payload.productKey;

        if (!productKey) {
            alert('Product Key is required. Select a source or enter a custom value.');
            return null;
        }

        const outputEl = document.getElementById('output-e2e-create');

        outputEl.value = 'Loading...';
        document.getElementById('e2e-save-section').style.display = 'none';

        e2eLog('→ createConfigurationV2 | payload: ' + JSON.stringify(payload), 'call');

        try {
            const result = sforce.apex.execute('CPQExternalConfiguratorController', 'createConfigurationV2', {
                configData: JSON.stringify(payload)
            });

            let formatted = '';
            let configId = null;
            try {
                const parsed = JSON.parse(result);
                formatted = JSON.stringify(parsed, null, 2);

                configId = (parsed.id)
                    || (parsed.configId)
                    || (parsed.configurationId)
                    || (parsed.data && parsed.data.id)
                    || null;

                if (configId) {
                    e2eLog('✅ createConfigurationV2 OK | configId: ' + configId, 'success');
                    e2eToast('Configuration created successfully.', 'success');
                    e2eSetCreateStatus('success', 'Configuration Created', '', configId);
                } else {
                    e2eLog('⚠️ createConfigurationV2 responded but no configId found in response', 'warn');
                    e2eToast('Configuration created without returned config ID.', 'warn');
                    e2eSetCreateStatus('warn', 'Configuration Response Without ID', 'The response did not include a configuration ID.', '');
                }
            } catch (e) {
                formatted = result;
                const rawResponse = (result === null || result === undefined) ? '' : String(result);
                e2eLog('⚠️ createConfigurationV2 response is not valid JSON: ' + rawResponse.substring(0, 200), 'warn');
                e2eToast('Configuration create returned a non-JSON response.', 'warn');
                e2eSetCreateStatus('warn', 'Unexpected Create Response', rawResponse.substring(0, 500), '');
            }

            outputEl.value = formatted;

            if (configId) {
                document.getElementById('e2e-captured-config-id').textContent = configId;
                document.getElementById('e2e-save-section').style.display = 'block';
                document.getElementById('e2e-save-status').textContent = '';

                const quoteId = document.getElementById('e2e-quoteId').value;
                if (quoteId) {
                    e2eLog('→ auto-save after create | quoteId: ' + quoteId + ' | configId: ' + configId, 'call');
                    e2eSaveConfigIdToQuoteInternal(quoteId, configId, true);
                } else {
                    e2eLog('⚠️ create OK but auto-save skipped: no quoteId in context', 'warn');
                    document.getElementById('e2e-save-status').textContent = 'Config created. Add Quote ID and click Save.';
                    document.getElementById('e2e-save-status').style.color = '#706e6b';
                }
            }

            return configId;
        } catch (error) {
            const errorText = e2eErrorToString(error);
            outputEl.value = 'Error: ' + errorText;
            e2eLog('❌ createConfigurationV2 ERROR: ' + errorText, 'error');
            e2eToast('Configuration create failed: ' + e2eExtractFriendlyError(errorText), 'error');
            e2eSetCreateStatus('error', 'Configuration Error', e2eExtractFriendlyError(errorText), '');
            return null;
        }
    }

    function e2eSaveConfigIdToQuoteInternal(quoteId, configId, isAuto) {
        const statusEl = document.getElementById('e2e-save-status');
        statusEl.textContent = isAuto ? 'Auto-saving...' : 'Saving...';

        try {
            const result = sforce.apex.execute('CPQExternalConfiguratorController', 'saveConfigIdToQuote', {
                quoteId: quoteId,
                configId: configId
            });

            let success = false;
            try {
                const parsed = JSON.parse(result);
                success = parsed.success === true;
            } catch (e) { }

            if (success) {
                document.getElementById('e2e-stored-config-id').value = configId;
                statusEl.textContent = isAuto ? '✅ Auto-saved to SAP_VCP_Config_ID__c!' : '✅ Saved to SAP_VCP_Config_ID__c!';
                statusEl.style.color = '#2e844a';
                e2eLog('✅ saveConfigIdToQuote OK | SAP_VCP_Config_ID__c updated on quote ' + quoteId, 'success');
                e2eToast(isAuto ? 'Config ID auto-saved to Quote.' : 'Config ID saved to Quote.', 'success');
            } else {
                statusEl.textContent = '⚠️ Response: ' + result;
                statusEl.style.color = '#c23934';
                const rawResponse = (result === null || result === undefined) ? '' : String(result);
                e2eLog('⚠️ saveConfigIdToQuote unexpected response: ' + rawResponse.substring(0, 200), 'warn');
                e2eToast('Save to Quote returned an unexpected response.', 'warn');
            }
        } catch (error) {
            const errorText = e2eErrorToString(error);
            statusEl.textContent = 'Error: ' + errorText;
            statusEl.style.color = '#c23934';
            e2eLog('❌ saveConfigIdToQuote ERROR: ' + errorText, 'error');
            e2eToast('Save to Quote failed: ' + e2eExtractFriendlyError(errorText), 'error');
        }
    }

    function e2eSaveConfigIdToQuote() {
        const quoteId = document.getElementById('e2e-quoteId').value;
        const configId = document.getElementById('e2e-captured-config-id').textContent;

        if (!quoteId) {
            alert('Quote ID is required. Pass ?SBQQ_QuoteId=... in the URL or enter it manually.');
            return;
        }
        if (!configId) {
            alert('No Config ID captured yet. Run Create Configuration first.');
            return;
        }

        e2eLog('→ manual saveConfigIdToQuote | quoteId: ' + quoteId + ' | configId: ' + configId, 'call');
        e2eSaveConfigIdToQuoteInternal(quoteId, configId, false);
    }

    function e2eReadConfigIdFromQuote() {
        const quoteId = document.getElementById('e2e-quoteId').value;
        if (!quoteId) {
            alert('Quote ID is required to read the stored config ID.');
            return null;
        }

        e2eLog('→ getConfigIdFromQuote | quoteId: ' + quoteId, 'call');
        try {
            const result = sforce.apex.execute('CPQExternalConfiguratorController', 'getConfigIdFromQuote', { quoteId: quoteId });
            const parsed = JSON.parse(result);
            if (parsed.success !== true) {
                const errorText = parsed.error || 'Unknown error';
                e2eLog('❌ getConfigIdFromQuote ERROR: ' + errorText, 'error');
                document.getElementById('e2e-stored-config-id').value = '';
                return null;
            }

            const configId = parsed.configId || '';
            document.getElementById('e2e-stored-config-id').value = configId;
            if (configId) {
                document.getElementById('e2e-captured-config-id').textContent = configId;
                document.getElementById('e2e-save-section').style.display = 'block';
                e2eLog('✅ Stored Config ID found on quote: ' + configId, 'success');
                e2eToast('Stored Config ID found on Quote.', 'success');
            } else {
                e2eLog('ℹ️ No stored Config ID found on quote', 'info');
                e2eToast('No stored Config ID found on Quote.', 'info');
            }
            return configId || null;
        } catch (error) {
            const errorText = e2eErrorToString(error);
            e2eLog('❌ getConfigIdFromQuote ERROR: ' + errorText, 'error');
            e2eToast('Read stored Config ID failed: ' + e2eExtractFriendlyError(errorText), 'error');
            return null;
        }
    }

    function e2eClearConfigIdFromQuote() {
        const quoteId = document.getElementById('e2e-quoteId').value;
        if (!quoteId) {
            alert('Quote ID is required to clear the stored config ID.');
            return;
        }

        e2eLog('→ clearConfigIdFromQuote | quoteId: ' + quoteId, 'call');
        try {
            const result = sforce.apex.execute('CPQExternalConfiguratorController', 'clearConfigIdFromQuote', { quoteId: quoteId });
            const parsed = JSON.parse(result);
            if (parsed.success === true) {
                document.getElementById('e2e-stored-config-id').value = '';
                document.getElementById('e2e-captured-config-id').textContent = '';
                document.getElementById('e2e-save-section').style.display = 'none';
                document.getElementById('e2e-save-status').textContent = 'Stored Config ID cleared from Quote';
                document.getElementById('e2e-save-status').style.color = '#706e6b';
                e2eLog('✅ Stored Config ID cleared from quote ' + quoteId, 'success');
                e2eToast('Stored Config ID cleared from Quote.', 'success');
            } else {
                e2eLog('❌ clearConfigIdFromQuote ERROR: ' + (parsed.error || 'Unknown error'), 'error');
                e2eToast('Clear stored Config ID failed.', 'error');
            }
        } catch (error) {
            e2eLog('❌ clearConfigIdFromQuote ERROR: ' + e2eErrorToString(error), 'error');
            e2eToast('Clear stored Config ID failed.', 'error');
        }
    }

    function e2eLoadConfigurationById(configId) {
        const outputEl = document.getElementById('output-e2e-load');

        if (!configId) {
            outputEl.value = 'Please provide a Configuration ID.';
            clearConfigurationForm('e2e-config-container');
            return null;
        }

        outputEl.value = 'Loading...';
        clearConfigurationForm('e2e-config-container');
        e2eLog('→ getConfigurationV2 | configId: ' + configId, 'call');

        try {
            let result = sforce.apex.execute('CPQExternalConfiguratorController', 'getConfigurationV2', { configId: configId });
            if (Array.isArray(result) && result.length > 0) {
                result = result[0];
            }

            const parsed = JSON.parse(result);
            e2eLoadedConfig = parsed;
            e2eEditorCurrentConfig = JSON.parse(JSON.stringify(parsed));
            const etag = parsed._eTag || e2eEditorCurrentETag || 'W/"1"';
            e2eEditorCurrentETag = etag;
            e2eEditorLastId = configId;
            e2eEditorOriginalValues = {};
            e2eEditorCharacteristicIndexMap = {};
            outputEl.value = JSON.stringify(parsed, null, 2);
            e2eRenderLoadedConfiguration();

            if (document.getElementById('e2e-label-mode').value !== 'api') {
                e2eLoadTranslationsForLanguage(document.getElementById('e2e-label-mode').value);
            }

            document.getElementById('e2e-etag').value = etag;
            e2eSyncETagPreset(etag);
            e2eSetInitialFlowCollapsed(true);
            e2eSetRuntimeVisible(true);
            setTimeout(function() {
                e2eScrollToTop();
            }, 60);
            e2eLog('✅ getConfigurationV2 OK | configId: ' + configId + (etag ? ' | _eTag: ' + etag : ''), 'success');
            e2eToast('Configuration loaded successfully.', 'success');
            return parsed;
        } catch (error) {
            const errorText = e2eErrorToString(error);
            outputEl.value = 'Error: ' + errorText;
            clearConfigurationForm('e2e-config-container');
            e2eLoadedConfig = null;
            e2eUpdateConfigSummary(null);
            e2eLog('❌ getConfigurationV2 ERROR: ' + errorText, 'error');
            e2eToast('Configuration load failed: ' + e2eExtractFriendlyError(errorText), 'error');
            return null;
        }
    }

    function e2eLoadStoredConfiguration() {
        const configId = e2eReadConfigIdFromQuote();
        if (configId) {
            e2eLoadConfigurationById(configId);
        }
    }

    function e2eSimulateLoading() {
        e2eLog('▶ simulate loading started', 'info');
        e2eSetCreateStageHidden(true);
        e2eSetSimulateControlsHidden(true);
        document.getElementById('e2e-save-section').style.display = 'none';

        let configId = e2eReadConfigIdFromQuote();
        const hadStoredConfig = !!configId;
        if (!configId) {
            e2eLog('No stored config found. Creating a new configuration...', 'warn');
            configId = e2eCreateConfig();
            if (!configId) {
                e2eSetCreateStageHidden(false);
                e2eSetSimulateControlsHidden(false);
                e2eLog('❌ simulate loading aborted: createConfigurationV2 failed', 'error');
                e2eToast('Simulate loading failed during configuration creation.', 'error');
                return;
            }
        }

        const loadedConfig = e2eLoadConfigurationById(configId);
        if (!loadedConfig) {
            e2eSetCreateStageHidden(false);
            e2eSetSimulateControlsHidden(false);
            e2eSetRuntimeVisible(false);

            if (hadStoredConfig) {
                e2eLog('⚠️ simulate loading failed for stored Config ID. Use restart button to regenerate a new Config ID.', 'warn');
                e2eToast('Stored Config ID appears invalid or expired. Restart to generate a new one.', 'warn');
            } else {
                e2eLog('⚠️ simulate loading could not load the newly created Config ID', 'warn');
                e2eToast('Could not load configuration. Please retry create/simulate.', 'warn');
            }
        }
    }

//]]>
</script>
</body>
</html>
</apex:page>

