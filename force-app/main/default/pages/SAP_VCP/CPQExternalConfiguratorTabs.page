        }
    }

    function e2eSetCreateStatus(type, title, message, configId) {
        const section = document.getElementById('e2e-save-section');
        const titleEl = document.getElementById('e2e-save-title');
        const configRow = document.getElementById('e2e-save-config-row');
        const messageEl = document.getElementById('e2e-save-message');
        const saveButton = document.getElementById('e2e-save-button');
        const saveStatus = document.getElementById('e2e-save-status');
        const configIdEl = document.getElementById('e2e-captured-config-id');

        const styles = {
            success: { background: '#e8f4e8', border: '#4bca81', buttonDisplay: 'inline-block' },
            error: { background: '#fdeaea', border: '#c23934', buttonDisplay: 'none' },
            warn: { background: '#fff7e6', border: '#f39c12', buttonDisplay: 'none' },
            info: { background: '#eef4ff', border: '#5dade2', buttonDisplay: 'none' }
        };
        const style = styles[type] || styles.info;

        section.style.display = 'block';
        section.style.background = style.background;
        section.style.borderLeftColor = style.border;
        titleEl.textContent = title || 'Configuration Status';
        configIdEl.textContent = configId || '';
        configRow.style.display = configId ? 'block' : 'none';
        messageEl.style.display = message ? 'block' : 'none';
        messageEl.textContent = message || '';
        saveButton.style.display = style.buttonDisplay;
        if (!configId) {
            saveStatus.textContent = '';
        }
    }

    // ─── End-to-End Tab ───────────────────────────────────────────────────────

    function e2eInitForm() {
        const productCode = getUrlParam('productCode');
        const quoteId     = getUrlParam('SBQQ_QuoteId') || getUrlParam('quoteId') || getUrlParam('qId');

        if (quoteId) {
            document.getElementById('e2e-quoteId').value = quoteId;
            document.getElementById('e2e-quoteId-source').textContent = '(from URL: SBQQ_QuoteId)';
        }

        if (productCode) {
            document.getElementById('e2e-productKey-mode').value = 'context';
        } else {
            document.getElementById('e2e-productKey-mode').value = 'working';
        }

        e2eApplyProductKeyMode();
        e2eUpdatePreview();

        if (quoteId || productCode) {
            e2eLog('Context loaded from URL — productCode: ' + (productCode || '—') + ', quoteId: ' + (quoteId || '—'), quoteId ? 'info' : 'warn');
        }

        ['e2e-kbId', 'e2e-productKey', 'e2e-date', 'e2e-autoCleanup'].forEach(function(id) {
            const el = document.getElementById(id);
            if (el) el.addEventListener('change', e2eUpdatePreview);
        });
    }

    function e2eApplyProductKeyMode() {
        const mode = document.getElementById('e2e-productKey-mode').value;
        const input = document.getElementById('e2e-productKey');
        const rescuedProductCode = getUrlParam('productCode') || '';

        if (mode === 'context') {
            input.value = rescuedProductCode;
            input.readOnly = true;
        } else if (mode === 'working') {
            input.value = 'F00K001001';
            input.readOnly = true;
        } else {
            if (input.value === rescuedProductCode || input.value === 'F00K001001') {
                input.value = '';
            }
            input.readOnly = false;
        }

        e2eLog('Product Key mode set to ' + mode + ' | value: ' + (input.value || '—'), 'info');
        e2eUpdatePreview();
    }

    function e2eGetCreatePayload() {
        return removeEmpty({
            kbId: document.getElementById('e2e-kbId').value || '-3',
            productKey: document.getElementById('e2e-productKey').value || '',
            date: document.getElementById('e2e-date').value,
            autoCleanup: document.getElementById('e2e-autoCleanup').checked
        });
    }

    function e2eUpdatePreview() {
        document.getElementById('e2e-create-preview').textContent = JSON.stringify(e2eGetCreatePayload(), null, 2);
    }

    function e2eApplyETagPreset() {
        const version = document.getElementById('e2e-etag-version').value;
        if (version === '') {
            return;
        }
        document.getElementById('e2e-etag').value = 'W/"' + version + '"';
        e2eLog('ETag preset selected: W/"' + version + '"', 'info');
    }

    function e2eSyncETagPreset(etag) {
        const match = /^W\/"(\d+)"$/.exec(etag || '');
        document.getElementById('e2e-etag-version').value = match ? match[1] : '';
    }

    function e2eUpdateConfigSummary(config) {
        const summaryEl = document.getElementById('e2e-config-summary');
        if (!summaryEl) {
            return;
        }
        if (!config || !config.rootItem || !Array.isArray(config.rootItem.characteristics)) {
            summaryEl.textContent = 'No configuration loaded yet';
            return;
        }

        const characteristics = config.rootItem.characteristics;
        const visibleCount = characteristics.filter(function(ch) { return ch.visible !== false; }).length;
        const hiddenCount = characteristics.length - visibleCount;
        const readonlyCount = characteristics.filter(function(ch) { return ch.readOnly === true; }).length;
        const requiredCount = characteristics.filter(function(ch) { return ch.required === true; }).length;

        summaryEl.textContent = 'Total: ' + characteristics.length
            + ' | Visible: ' + visibleCount
            + ' | Hidden/dependent: ' + hiddenCount
            + ' | Readonly: ' + readonlyCount
            + ' | Required: ' + requiredCount;
    }

    function e2eRenderLoadedConfiguration() {
        const mode = document.getElementById('e2e-field-visibility-mode').value;
        if (!e2eLoadedConfig) {
            clearConfigurationForm('e2e-config-container');
            e2eUpdateConfigSummary(null);
            return;
        }

        renderConfigurationForm(e2eLoadedConfig, 'e2e-config-container', {
            editable: false,
            storeOriginal: false,
            showHidden: mode === 'all'
        });
        e2eUpdateConfigSummary(e2eLoadedConfig);
        e2eLog('Rendered configuration in mode: ' + mode, 'info');
    }

    function e2eResetFlow() {
        e2eSetCreateStageHidden(false);
        e2eSetSimulateControlsHidden(false);
        e2eSetRuntimeVisible(false);
        document.getElementById('e2e-save-section').style.display = 'none';
        document.getElementById('e2e-save-status').textContent = '';
        document.getElementById('e2e-save-message').textContent = '';
        document.getElementById('e2e-save-message').style.display = 'none';
        document.getElementById('e2e-toggle-create-stage').style.display = 'none';
        document.getElementById('e2e-field-visibility-mode').value = 'visible';
        document.getElementById('e2e-config-summary').textContent = 'No configuration loaded yet';
        document.getElementById('output-e2e-load').value = '';
        clearTable('table-e2e-load');
        clearConfigurationForm('e2e-config-container');
        e2eLoadedConfig = null;
        e2eLog('Flow reset to initial state', 'info');
    }

    function e2eCreateConfig() {
        const payload = e2eGetCreatePayload();
        const productKey = payload.productKey;

        if (!productKey) {
            alert('Product Key is required. Select a source or enter a custom value.');
            return null;
        }

        const outputEl = document.getElementById('output-e2e-create');
        const tableId  = 'table-e2e-create';

        outputEl.value = 'Loading...';
        clearTable(tableId);
        document.getElementById('e2e-save-section').style.display = 'none';

        e2eLog('→ createConfigurationV2 | payload: ' + JSON.stringify(payload), 'call');

        try {
            const result = sforce.apex.execute('CPQExternalConfiguratorController', 'createConfigurationV2', {
                configData: JSON.stringify(payload)
            });

            let formatted = '';
            let configId = null;
            try {
                const parsed = JSON.parse(result);
                formatted = JSON.stringify(parsed, null, 2);
                renderTable(parsed, tableId);

                configId = (parsed.id)
                    || (parsed.configId)
                    || (parsed.configurationId)
                    || (parsed.data && parsed.data.id)
                    || null;

                if (configId) {
                    e2eLog('✅ createConfigurationV2 OK | configId: ' + configId, 'success');
                    e2eSetCreateStatus('success', 'Configuration Created', '', configId);
                } else {
                    e2eLog('⚠️ createConfigurationV2 responded but no configId found in response', 'warn');
                    e2eSetCreateStatus('warn', 'Configuration Response Without ID', 'The response did not include a configuration ID.', '');
                }
            } catch (e) {
                formatted = result;
                const rawResponse = (result === null || result === undefined) ? '' : String(result);
                e2eLog('⚠️ createConfigurationV2 response is not valid JSON: ' + rawResponse.substring(0, 200), 'warn');
                e2eSetCreateStatus('warn', 'Unexpected Create Response', rawResponse.substring(0, 500), '');
            }

            outputEl.value = formatted;

            if (configId) {
                document.getElementById('e2e-captured-config-id').textContent = configId;
                document.getElementById('e2e-save-section').style.display = 'block';
                document.getElementById('e2e-save-status').textContent = '';

                const quoteId = document.getElementById('e2e-quoteId').value;
                if (quoteId) {
                    e2eLog('→ auto-save after create | quoteId: ' + quoteId + ' | configId: ' + configId, 'call');
                    e2eSaveConfigIdToQuoteInternal(quoteId, configId, true);
                } else {
                    e2eLog('⚠️ create OK but auto-save skipped: no quoteId in context', 'warn');
                    document.getElementById('e2e-save-status').textContent = 'Config created. Add Quote ID and click Save.';
                    document.getElementById('e2e-save-status').style.color = '#706e6b';
                }
            }

            return configId;
        } catch (error) {
            const errorText = e2eErrorToString(error);
            outputEl.value = 'Error: ' + errorText;
            e2eLog('❌ createConfigurationV2 ERROR: ' + errorText, 'error');
            e2eSetCreateStatus('error', 'Configuration Error', e2eExtractFriendlyError(errorText), '');
            return null;
        }
    }

    function e2eSaveConfigIdToQuoteInternal(quoteId, configId, isAuto) {
        const statusEl = document.getElementById('e2e-save-status');
        statusEl.textContent = isAuto ? 'Auto-saving...' : 'Saving...';

        try {
            const result = sforce.apex.execute('CPQExternalConfiguratorController', 'saveConfigIdToQuote', {
                quoteId: quoteId,
                configId: configId
            });

            let success = false;
            try {
                const parsed = JSON.parse(result);
                success = parsed.success === true;
            } catch (e) { }

            if (success) {
                document.getElementById('e2e-stored-config-id').value = configId;
                statusEl.textContent = isAuto ? '✅ Auto-saved to SAP_VCP_Config_ID__c!' : '✅ Saved to SAP_VCP_Config_ID__c!';
                statusEl.style.color = '#2e844a';
                e2eLog('✅ saveConfigIdToQuote OK | SAP_VCP_Config_ID__c updated on quote ' + quoteId, 'success');
            } else {
                statusEl.textContent = '⚠️ Response: ' + result;
                statusEl.style.color = '#c23934';
                const rawResponse = (result === null || result === undefined) ? '' : String(result);
                e2eLog('⚠️ saveConfigIdToQuote unexpected response: ' + rawResponse.substring(0, 200), 'warn');
            }
        } catch (error) {
            const errorText = e2eErrorToString(error);
            statusEl.textContent = 'Error: ' + errorText;
            statusEl.style.color = '#c23934';
            e2eLog('❌ saveConfigIdToQuote ERROR: ' + errorText, 'error');
        }
    }

    function e2eSaveConfigIdToQuote() {
        const quoteId = document.getElementById('e2e-quoteId').value;
        const configId = document.getElementById('e2e-captured-config-id').textContent;

        if (!quoteId) {
            alert('Quote ID is required. Pass ?SBQQ_QuoteId=... in the URL or enter it manually.');
            return;
        }
        if (!configId) {
            alert('No Config ID captured yet. Run Create Configuration first.');
            return;
        }

        e2eLog('→ manual saveConfigIdToQuote | quoteId: ' + quoteId + ' | configId: ' + configId, 'call');
        e2eSaveConfigIdToQuoteInternal(quoteId, configId, false);
    }

    function e2eReadConfigIdFromQuote() {
        const quoteId = document.getElementById('e2e-quoteId').value;
        if (!quoteId) {
            alert('Quote ID is required to read the stored config ID.');
            return null;
        }

        e2eLog('→ getConfigIdFromQuote | quoteId: ' + quoteId, 'call');
        try {
            const result = sforce.apex.execute('CPQExternalConfiguratorController', 'getConfigIdFromQuote', { quoteId: quoteId });
            const parsed = JSON.parse(result);
            if (parsed.success !== true) {
                const errorText = parsed.error || 'Unknown error';
                e2eLog('❌ getConfigIdFromQuote ERROR: ' + errorText, 'error');
                document.getElementById('e2e-stored-config-id').value = '';
                return null;
            }

            const configId = parsed.configId || '';
            document.getElementById('e2e-stored-config-id').value = configId;
            if (configId) {
                document.getElementById('e2e-captured-config-id').textContent = configId;
                document.getElementById('e2e-save-section').style.display = 'block';
                e2eLog('✅ Stored Config ID found on quote: ' + configId, 'success');
            } else {
                e2eLog('ℹ️ No stored Config ID found on quote', 'info');
            }
            return configId || null;
        } catch (error) {
            const errorText = e2eErrorToString(error);
            e2eLog('❌ getConfigIdFromQuote ERROR: ' + errorText, 'error');
            return null;
        }
    }

    function e2eClearConfigIdFromQuote() {
        const quoteId = document.getElementById('e2e-quoteId').value;
        if (!quoteId) {
            alert('Quote ID is required to clear the stored config ID.');
            return;
        }

        e2eLog('→ clearConfigIdFromQuote | quoteId: ' + quoteId, 'call');
        try {
            const result = sforce.apex.execute('CPQExternalConfiguratorController', 'clearConfigIdFromQuote', { quoteId: quoteId });
            const parsed = JSON.parse(result);
            if (parsed.success === true) {
                document.getElementById('e2e-stored-config-id').value = '';
                document.getElementById('e2e-captured-config-id').textContent = '';
                document.getElementById('e2e-save-section').style.display = 'none';
                document.getElementById('e2e-save-status').textContent = 'Stored Config ID cleared from Quote';
                document.getElementById('e2e-save-status').style.color = '#706e6b';
                e2eLog('✅ Stored Config ID cleared from quote ' + quoteId, 'success');
            } else {
                e2eLog('❌ clearConfigIdFromQuote ERROR: ' + (parsed.error || 'Unknown error'), 'error');
            }
        } catch (error) {
            e2eLog('❌ clearConfigIdFromQuote ERROR: ' + e2eErrorToString(error), 'error');
        }
    }

    function e2eLoadConfigurationById(configId) {
        const outputEl = document.getElementById('output-e2e-load');
        const tableId = 'table-e2e-load';

        if (!configId) {
            outputEl.value = 'Please provide a Configuration ID.';
            clearTable(tableId);
            clearConfigurationForm('e2e-config-container');
            return null;
        }

        outputEl.value = 'Loading...';
        clearTable(tableId);
        clearConfigurationForm('e2e-config-container');
        e2eLog('→ getConfigurationV2 | configId: ' + configId, 'call');

        try {
            let result = sforce.apex.execute('CPQExternalConfiguratorController', 'getConfigurationV2', { configId: configId });
            if (Array.isArray(result) && result.length > 0) {
                result = result[0];
            }

            const parsed = JSON.parse(result);
            e2eLoadedConfig = parsed;
            outputEl.value = JSON.stringify(parsed, null, 2);
            renderTable(parsed, tableId);
            e2eRenderLoadedConfiguration();

            const etag = parsed._eTag || '';
            document.getElementById('e2e-etag').value = etag;
            e2eSyncETagPreset(etag);
            e2eSetRuntimeVisible(true);
            e2eLog('✅ getConfigurationV2 OK | configId: ' + configId + (etag ? ' | _eTag: ' + etag : ''), 'success');
            return parsed;
        } catch (error) {
            const errorText = e2eErrorToString(error);
            outputEl.value = 'Error: ' + errorText;
            clearTable(tableId);
            clearConfigurationForm('e2e-config-container');
            e2eLoadedConfig = null;
            e2eUpdateConfigSummary(null);
            e2eLog('❌ getConfigurationV2 ERROR: ' + errorText, 'error');
            return null;
        }
    }

    function e2eLoadStoredConfiguration() {
        const configId = e2eReadConfigIdFromQuote();
        if (configId) {
            e2eLoadConfigurationById(configId);
        }
    }

    function e2eSimulateLoading() {
        e2eLog('▶ simulate loading started', 'info');
        e2eSetCreateStageHidden(true);
        e2eSetSimulateControlsHidden(true);

        let configId = e2eReadConfigIdFromQuote();
        if (!configId) {
            e2eLog('No stored config found. Creating a new configuration...', 'warn');
            configId = e2eCreateConfig();
            if (!configId) {
                e2eSetCreateStageHidden(false);
                e2eSetSimulateControlsHidden(false);
                e2eLog('❌ simulate loading aborted: createConfigurationV2 failed', 'error');
                return;
            }
        }

        e2eLoadConfigurationById(configId);
    }

//]]>
</script>
</body>
</html>
