<body>

<div class="main-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h1>SAP VC API Testing</h1>
            <p style="margin: 8px 0 0 0; color: rgba(255,255,255,0.8); font-size: 12px; line-height: 1.4;">Alberto PoC</p>
        </div>
        <ul class="sidebar-menu">
            <li class="sidebar-menu-item">
                <a href="javascript:void(0)" onclick="switchCategory(event, 'kb')" class="sidebar-menu-link active">
                    📚 Knowledge Bases
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a href="javascript:void(0)" onclick="switchCategory(event, 'config')" class="sidebar-menu-link">
                    ⚙️ Configurations
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a href="javascript:void(0)" onclick="switchCategory(event, 'pricing')" class="sidebar-menu-link">
                    💰 Pricing
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a href="javascript:void(0)" onclick="switchCategory(event, 'cheatsheet')" class="sidebar-menu-link">
                    🐛 Cheatsheet
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a href="javascript:void(0)" onclick="switchCategory(event, 'e2e')" class="sidebar-menu-link">
                    🔄 End-to-End
                </a>
            </li>
        </ul>
    </div>
    
    <!-- Content Area -->
    <div class="content-area">
        <div class="content-header">
            <h1 id="current-title">Knowledge Bases</h1>
            <div id="cpq-context-bar" style="display:none; margin-top:6px; font-size:12px; color:#555;">
                Product Code: <strong id="cpq-product-code"></strong>
                <span id="cpq-context-raw" style="margin-left:12px; color:#999;"></span>
            </div>
        </div>
        
        <div class="content-body">
            
            <!-- Knowledge Bases Category -->
            <div id="category-kb" class="tab-panel active">
                <!-- Horizontal Tabs -->
                <div style="display: flex; gap: 0; border-bottom: 2px solid #e5e5e5; margin-bottom: 30px;">
                    <a href="javascript:void(0)" onclick="switchSubTab(event, 'kb', 'determine')" class="sub-tab-link active">Determine KB</a>
                    <a href="javascript:void(0)" onclick="switchSubTab(event, 'kb', 'details')" class="sub-tab-link">Get Details</a>
                    <a href="javascript:void(0)" onclick="switchSubTab(event, 'kb', 'translations')" class="sub-tab-link">Get Translations</a>
                </div>
                
                <!-- Determine KB -->
                <div id="subtab-kb-determine" class="sub-tab-panel active">
                    <div class="tab-box">
                        <h2>Determine Knowledge Base</h2>
                        <p>Retrieves a list of knowledge bases (header data only). Possible search criteria are product ID, validity date, type and plant.</p>
                        <div class="endpoint-info">
                            <span class="endpoint-method">GET</span>
                            <span class="endpoint-path" id="determine-endpoint">/api/v2/kbdetermination</span>
                        </div>
                        
                        <div class="form-row">
                            <div class="form-left">
                                <div class="form-section">
                                    <label>Product ID</label>
                                    <input type="text" id="determine-productId" placeholder="e.g., MAC-BOOK" onkeyup="updateDeterminePreview()"/>
                                </div>
                                <div class="form-section">
                                    <label>Validity Date (Optional)</label>
                                    <input type="date" id="determine-validityDate" onchange="updateDeterminePreview()"/>
                                </div>
                                <div class="form-section">
                                    <label>Type (Optional)</label>
                                    <input type="text" id="determine-type" placeholder="e.g., MARA" onkeyup="updateDeterminePreview()"/>
                                </div>
                                <div class="form-section">
                                    <label>Plant (Optional)</label>
                                    <input type="text" id="determine-plant" placeholder="e.g., 1000" onkeyup="updateDeterminePreview()"/>
                                </div>
                            </div>
                            
                            <div class="form-right">
                                <label class="preview-label">Request URL Preview</label>
                                <div class="preview-box" id="determine-preview">/api/v2/kbdetermination</div>
                            </div>
                        </div>
                        
                        <div class="button-group">
                            <button class="slds-button slds-button_brand" onclick="callAPI('determine')">Execute Request</button>
                        </div>
                        <label class="response-title">Response:</label>
                        <div class="response-table" id="table-determine"></div>
                        <div class="response-section">
                            <textarea id="output-determine" readonly="readonly"></textarea>
                        </div>
                    </div>
                </div>
                
                <!-- Get KB Details -->
                <div id="subtab-kb-details" class="sub-tab-panel" style="display: none;">
                    <div class="tab-box">
                        <h2>Get Knowledge Base Details</h2>
                        <p>Retrieves the knowledge base identified by the specified identifier and the corresponding localized texts filtered by the language parameter. The relevant information about the master data like characteristic name, long text should be cached by the caller for better performance.</p>
                        <div class="endpoint-info">
                            <span class="endpoint-method">GET</span>
                            <span class="endpoint-path">/api/v2/knowledgebases/{id}</span>
                        </div>
                        <div class="form-section">
                            <label>Knowledge Base ID</label>
                            <input type="text" id="input-kbid" placeholder="Enter KB ID"/>
                        </div>
                        <div class="button-group">
                            <button class="slds-button slds-button_brand" onclick="callAPI('get-kb')">Execute Request</button>
                        </div>
                        <label class="response-title">Response:</label>
                        <div class="response-table" id="table-get-kb"></div>
                        <div class="response-section">
                            <textarea id="output-get-kb" readonly="readonly"></textarea>
                        </div>
                    </div>
                </div>
                
                <!-- Get KB Translations -->
                <div id="subtab-kb-translations" class="sub-tab-panel" style="display: none;">
                    <div class="tab-box">
                        <h2>Get Knowledge Base Translations</h2>
                        <p>Retrieves localized short and long texts for characteristics, values, and other elements in the knowledge base for the specified language.</p>
                        <div class="endpoint-info">
                            <span class="endpoint-method">GET</span>
                            <span class="endpoint-path">/api/v2/knowledgebases/{kbId}/translations</span>
                        </div>
                        <div class="form-section">
                            <label>Knowledge Base ID</label>
                            <input type="text" id="input-kb-trans-id" placeholder="Enter KB ID"/>
                        </div>
                        <div class="form-section">
                            <label>Language (Optional)</label>
                            <input type="text" id="input-kb-trans-language" placeholder="e.g., en, de, es"/>
                        </div>
                        <div class="button-group">
                            <button class="slds-button slds-button_brand" onclick="callAPI('get-translations')">Execute Request</button>
                        </div>
                        <label class="response-title">Response:</label>
                        <div class="response-table" id="table-get-translations"></div>
                        <div class="response-section">
                            <textarea id="output-get-translations" readonly="readonly"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Configurations Category -->
            <div id="category-config" class="tab-panel" style="display: none;">
                <!-- Horizontal Tabs -->
                <div style="display: flex; gap: 0; border-bottom: 2px solid #e5e5e5; margin-bottom: 30px;">
                    <a href="javascript:void(0)" onclick="switchSubTab(event, 'config', 'create')" class="sub-tab-link active">Create</a>
                    <a href="javascript:void(0)" onclick="switchSubTab(event, 'config', 'patch')" class="sub-tab-link">Patch</a>
