    function renderConfigurationForm(config, containerId, options) {
        const targetId = containerId || 'config-form-container';
        const container = document.getElementById(targetId);
        if (!container) {
            return;
        }

        container.innerHTML = '';

        if (!config || !config.rootItem || !Array.isArray(config.rootItem.characteristics)) {
            return;
        }

        const settings = options || {};
        const editable = settings.editable === true;
        const storeOriginal = settings.storeOriginal === true;
        const showHidden = settings.showHidden === true;

        const header = document.createElement('div');
        header.className = 'config-form-header';

        const kbTitle = document.createElement('div');
        kbTitle.className = 'config-kb-title';
        const kbName = config.kbKey && config.kbKey.name ? config.kbKey.name : 'KB';
        const kbVersion = config.kbKey && config.kbKey.version ? config.kbKey.version : '';
        kbTitle.textContent = kbVersion ? (kbName + ' · v' + kbVersion) : kbName;
        header.appendChild(kbTitle);

        const visibleGroups = Array.isArray(config.rootItem.characteristicGroups)
            ? config.rootItem.characteristicGroups.filter((group) => group.visible !== false)
            : [];

        if (visibleGroups.length > 0) {
            const groupList = document.createElement('div');
            groupList.className = 'config-group-list';
            visibleGroups.forEach((group) => {
                const pill = document.createElement('span');
                pill.className = 'config-group-pill';
                pill.textContent = group.id || 'Group';
                groupList.appendChild(pill);
            });
            header.appendChild(groupList);
        }

        container.appendChild(header);

        const grid = document.createElement('div');
        grid.className = 'config-form-grid';

        config.rootItem.characteristics.forEach((ch, index) => {
            if (ch.visible === false && !showHidden) {
                return;
            }

            const field = document.createElement('div');
            field.className = 'config-field' + (ch.readOnly ? ' readonly' : '');
            if (ch.visible === false) {
                field.style.borderStyle = 'dashed';
                field.style.opacity = '0.92';
            }

            const title = document.createElement('div');
            title.className = 'config-field-title';
            title.textContent = ch.id || 'Characteristic';
            if (ch.required) {
                const req = document.createElement('span');
                req.className = 'required-indicator';
                req.textContent = '*';
                title.appendChild(req);
            }
            field.appendChild(title);

            const currentValue = (Array.isArray(ch.values) && ch.values[0] && ch.values[0].value)
                ? ch.values[0].value
                : '';

            if (storeOriginal && ch.id) {
                configEditorOriginalValues[ch.id] = currentValue || '';
            }

            if (Array.isArray(ch.possibleValues) && ch.possibleValues.length > 0) {
                const options = document.createElement('div');
                options.className = 'config-field-options';

                ch.possibleValues.forEach((pv, pvIndex) => {
                    const label = document.createElement('label');
                    label.style.display = 'flex';
                    label.style.gap = '8px';
                    label.style.alignItems = 'center';

                    const input = document.createElement('input');
                    input.type = 'radio';
                    input.name = 'char-' + (ch.id || index);
                    input.value = pv.valueLow || '';
                    input.disabled = ch.readOnly === true || pv.selectable === false || editable === false;
                    input.setAttribute('data-char-id', ch.id || '');
                    if (input.value && input.value === currentValue) {
                        input.checked = true;
                    }
                    
                    if (editable && targetId === 'config-editor-container') {
                        input.addEventListener('change', function() {
                            buildPatchOperationsFromEditor();
                        });
                    }

                    const text = document.createElement('span');
                    text.textContent = pv.valueLow || '(empty)';

                    label.appendChild(input);
                    label.appendChild(text);
                    options.appendChild(label);
                });

                field.appendChild(options);
            } else {
                const input = document.createElement('input');
                input.type = 'text';
                input.value = currentValue || '';
                input.disabled = ch.readOnly === true || editable === false;
                input.setAttribute('data-char-id', ch.id || '');
                
                if (editable && targetId === 'config-editor-container') {
                    input.addEventListener('input', function() {
                        buildPatchOperationsFromEditor();
                    });
                }
                
                field.appendChild(input);
            }

            const metaParts = [];
            if (ch.visible === false) {
                metaParts.push('hidden/dependent');
            }
            if (ch.readOnly) {
                metaParts.push('readonly');
            }
            if (ch.consistent === false) {
                metaParts.push('inconsistent');
            }
            if (ch.complete === false) {
                metaParts.push('incomplete');
            }
            if (metaParts.length > 0) {
                const meta = document.createElement('div');
                meta.className = 'meta';
                meta.textContent = metaParts.join(' · ');
                field.appendChild(meta);
            }

            grid.appendChild(field);
        });

        container.appendChild(grid);
    }

    function loadConfigurationEditor() {
        const configId = document.getElementById('input-config-editor-id').value;
        const textarea = document.getElementById('output-config-editor');
        const tableId = 'table-config-editor';

        console.log('=== loadConfigurationEditor called ===');
        console.log('=== Config ID from input:', configId);
        console.log('=== Config ID is empty:', !configId);

        if (!configId) {
            textarea.value = 'Please provide a Configuration ID.';
            clearTable(tableId);
            clearConfigurationForm('config-editor-container');
            showStatusMessage('Please provide a Configuration ID', 'error');
            return;
        }

        showStatusMessage('Loading configuration...', 'info');
        textarea.value = 'Loading...';
        clearTable(tableId);
        clearConfigurationForm('config-editor-container');
        configEditorOriginalValues = {};
        configEditorCharacteristicIndexMap = {};
        configEditorLastId = configId;
        configEditorCurrentConfig = null;
        configEditorCurrentETag = null;

        try {
            console.log('=== Calling getConfigurationV2 with configId:', configId);
            let result = sforce.apex.execute('CPQExternalConfiguratorController', 'getConfigurationV2', { configId: configId });
            
            console.log('=== getConfigurationV2 result received:', result);
            console.log('=== result type:', typeof result, 'is array:', Array.isArray(result));
            
            if (!result) {
                textarea.value = 'Error: No response from server';
                showStatusMessage('No response from server', 'error');
                return;
            }
            
            // Handle if sforce.apex.execute returns an array with the response inside
            if (Array.isArray(result) && result.length > 0) {
                result = result[0];
                console.log('=== Extracted result from array:', result);
            }
            
            let formatted = '';
            try {
                const parsed = JSON.parse(result);
                
                console.log('=== Parsed response:', parsed);
                console.log('=== _eTag from response:', parsed._eTag);
                
                // Extract and save ETag in the config object so it's available later
                const displayConfig = JSON.parse(JSON.stringify(parsed));
                configEditorCurrentETag = parsed._eTag || null;
                
                // Keep _eTag in the config object for updateConfigurationEditor
                configEditorCurrentConfig = displayConfig;
                
                console.log('=== Saved ETag:', configEditorCurrentETag);
                console.log('=== Config object _eTag:', configEditorCurrentConfig._eTag);
                
                // Update ETag input field with the current value
                const etagInput = document.getElementById('input-config-etag');
                if (etagInput) {
                    etagInput.value = configEditorCurrentETag || '';
                    console.log('=== Updated ETag input field with:', configEditorCurrentETag);
                }
                
                formatted = JSON.stringify(displayConfig, null, 2);
                
                // Build index map for characteristics
                if (displayConfig.rootItem && Array.isArray(displayConfig.rootItem.characteristics)) {
                    displayConfig.rootItem.characteristics.forEach((ch, idx) => {
                        if (ch.id) {
                            configEditorCharacteristicIndexMap[ch.id] = idx;
                        }
                    });
                }
                
                renderTable(displayConfig, tableId);
                renderConfigurationForm(displayConfig, 'config-editor-container', { editable: true, storeOriginal: true });
                showStatusMessage('Configuration loaded successfully', 'success');
            } catch (parseError) {
                formatted = result;
                renderTable(result, tableId);
                showStatusMessage('Error parsing response', 'error');
            }
            
            textarea.value = formatted;
        } catch (error) {
            const errorMsg = error && error.message ? error.message : String(error);
            textarea.value = 'Error: ' + errorMsg;
            console.error('Load Configuration Error:', error);
            showStatusMessage('Error loading configuration', 'error');
        }
    }

    function buildPatchOperationsFromEditor() {
        const container = document.getElementById('config-editor-container');
        if (!container || !configEditorCurrentConfig) {
            return [];
        }

        const updates = {};

        const radioInputs = container.querySelectorAll('input[type="radio"][data-char-id]');
        const radioGroups = {};
        radioInputs.forEach((input) => {
            const charId = input.getAttribute('data-char-id');
            if (!charId) {
                return;
            }
            radioGroups[charId] = radioGroups[charId] || [];
            radioGroups[charId].push(input);
        });

        Object.keys(radioGroups).forEach((charId) => {
            const selected = radioGroups[charId].find((input) => input.checked);
            if (selected) {
                updates[charId] = selected.value;
            }
        });

        const textInputs = container.querySelectorAll('input[type="text"][data-char-id]');
        textInputs.forEach((input) => {
            const charId = input.getAttribute('data-char-id');
            if (!charId) {
                return;
            }
            updates[charId] = input.value;
        });

        // Build array of PATCH operations for each modified characteristic
        // Each operation targets: PATCH /api/v2/configurations/{id}/items/{itemId}/characteristics/{charId}
        const patchOperations = [];
        const rootItem = configEditorCurrentConfig.rootItem;
        const itemId = rootItem.itemId || 1; // Default to 1 for root item
        
        Object.keys(updates).forEach((charId) => {
            const newValue = updates[charId];
            const originalValue = configEditorOriginalValues[charId] ?? '';
            
            if (String(newValue ?? '') !== String(originalValue ?? '')) {
                // Build characteristic input for this specific characteristic
                // SAP VC requires 'selected' field in each value
                const charInput = {
                    characteristicId: charId,
                    values: newValue ? [{ value: newValue, selected: true }] : []
                };
                
                patchOperations.push({
                    characteristicId: charId,
                    itemId: itemId,
                    input: charInput
                });
            }
        });
        
        // Update preview
        const previewElement = document.getElementById('config-patch-preview');
        if (previewElement) {
            if (patchOperations.length === 0) {
                previewElement.textContent = 'No changes detected';
            } else {
                const preview = {
                    operationCount: patchOperations.length,
                    operations: patchOperations.map(op => ({
                        endpoint: `/api/v2/configurations/{id}/items/${op.itemId}/characteristics/${op.characteristicId}`,
                        method: 'PATCH',
                        body: op.input
                    }))
                };
                previewElement.textContent = JSON.stringify(preview, null, 2);
            }
        }

        return patchOperations.length > 0 ? patchOperations : null;
    }

    function updateConfigurationEditor() {
        const textarea = document.getElementById('output-config-editor');
        const tableId = 'table-config-editor';
        const configId = document.getElementById('input-config-editor-id').value || configEditorLastId;
        const etagInput = document.getElementById('input-config-etag');

        if (!configId) {
            textarea.value = 'Please provide a Configuration ID.';
            showStatusMessage('Please provide a Configuration ID', 'error');
            return;
        }

        // Validate that configuration is loaded
        if (!configEditorCurrentConfig) {
            textarea.value = 'Configuration not loaded. Please click "Load Configuration" first.';
            showStatusMessage('Configuration not loaded', 'error');
            return;
        }

        // Get ETag: Priority: input field > config._eTag > config variable > default W/"1"
        let etag = (etagInput && etagInput.value) ? etagInput.value : null;
        if (!etag) {
            etag = configEditorCurrentConfig._eTag || configEditorCurrentETag || 'W/"1"';
        }
        
        console.log('=== Checking ETag ===');
        console.log('=== ETag from input field:', (etagInput && etagInput.value));
        console.log('=== configEditorCurrentConfig._eTag:', configEditorCurrentConfig._eTag);
        console.log('=== configEditorCurrentETag:', configEditorCurrentETag);
        console.log('=== resolved etag:', etag);
        console.log('=== All keys in configEditorCurrentConfig:', Object.keys(configEditorCurrentConfig));
        
        showStatusMessage('Using ETag: ' + etag, 'info', 3000);

        const patchOps = buildPatchOperationsFromEditor();
        if (!patchOps) {
            textarea.value = 'No changes detected.';
            showStatusMessage('No changes detected', 'info');
            return;
        }

        try {
            showStatusMessage('Updating configuration...', 'info');
            textarea.value = 'Updating...';
            clearTable(tableId);
            
            console.log('=== updateConfigurationEditor ===');
            console.log('=== Config ID:', configId);
            console.log('=== ETag:', etag);
            console.log('=== Current Config:', configEditorCurrentConfig);
            console.log('=== PATCH Operations to send:', JSON.stringify(patchOps, null, 2));
            
            let patchResult = sforce.apex.execute(
                'CPQExternalConfiguratorController',
                'patchConfigurationCharacteristics',
                { 
                    configId: configId, 
                    etag: etag,
                    patchOperations: JSON.stringify(patchOps) 
                }
            );

            console.log('=== Apex response received:', patchResult);
            
            // Handle if sforce.apex.execute returns an array with the response inside
            if (Array.isArray(patchResult) && patchResult.length > 0) {
                patchResult = patchResult[0];
                console.log('=== Extracted patchResult from array:', patchResult);
            }

            if (!patchResult) {
                textarea.value = 'Error: No response from PATCH operation';
                showStatusMessage('No response from PATCH operation', 'error');
                return;
            }

            let formatted = '';
            try {
                const parsedPatch = JSON.parse(patchResult);
                formatted = JSON.stringify(parsedPatch, null, 2);
                renderTable(parsedPatch, tableId);
                
                // Check if PATCH was successful
                if (parsedPatch.success === true) {
                    showStatusMessage('Configuration updated successfully. Capturing ETag and reloading...', 'success', 3000);
                    
                    // Try to capture ETag from PATCH response
                    if (parsedPatch.latestETag) {
                        console.log('=== New ETag captured from PATCH response:', parsedPatch.latestETag);
                        configEditorCurrentETag = parsedPatch.latestETag;
                        document.getElementById('input-config-etag').value = parsedPatch.latestETag;
                    } else if (parsedPatch.results) {
                        const firstResult = Object.values(parsedPatch.results)[0];
                        if (firstResult && firstResult.eTag) {
                            const newETag = firstResult.eTag;
                            console.log('=== New ETag captured from first result:', newETag);
                            configEditorCurrentETag = newETag;
                            document.getElementById('input-config-etag').value = newETag;
                        }
                    }
                    
                    // Auto-reload configuration to get updated values and latest ETag
                    setTimeout(function() {
                        console.log('=== Auto-reloading configuration after successful PATCH ===');
                        loadConfigurationEditor();
                    }, 1500);
                } else if (parsedPatch.success === false) {
                    // PATCH failed - show error details
                    let errorMsg = 'PATCH failed: ';
                    if (parsedPatch.results) {
                        const resultKeys = Object.keys(parsedPatch.results);
                        for (const key of resultKeys) {
                            const result = parsedPatch.results[key];
                            if (result.error) {
                                errorMsg += key + ' - ' + (typeof result.error === 'string' ? JSON.parse(result.error).message : result.error.message) + '; ';
                            }
                        }
                    }
                    showStatusMessage(errorMsg, 'error', 7000);
                } else {
                    showStatusMessage('Configuration update completed.', 'info', 5000);
                }
            } catch (e) {
                formatted = patchResult;
                renderTable(patchResult, tableId);
                showStatusMessage('Configuration update completed. Reloading...', 'info', 3000);
                setTimeout(function() {
                    loadConfigurationEditor();
                }, 1500);
            }
            
            textarea.value = formatted;
        } catch (error) {
            const errorMsg = error && error.message ? error.message : String(error);
            textarea.value = 'Error: ' + errorMsg;
            console.error('Update Configuration Error:', error);
            console.error('Patch operations attempted:', patchOps);
            showStatusMessage('Error updating configuration', 'error', 5000);
        }
    }

    function executePricingRequest(apexMethod, params, tableId, outputId, onSuccess) {
        const textarea = document.getElementById(outputId);
        clearTable(tableId);
        textarea.value = 'Processing...';
        showStatusMessage('Processing pricing request...', 'info');

        try {
            let result = sforce.apex.execute('CPQExternalConfiguratorController', apexMethod, params);
            if (Array.isArray(result) && result.length > 0) {
                result = result[0];
            }

            if (!result) {
                textarea.value = 'Error: No response from server';
                showStatusMessage('No response from server', 'error');
                return;
            }

            try {
                const parsed = JSON.parse(result);
                textarea.value = JSON.stringify(parsed, null, 2);
                renderTable(parsed, tableId);
                if (onSuccess) {
                    onSuccess(parsed);
                }
            } catch (e) {
                textarea.value = result;
                renderTable(result, tableId);
            }
        } catch (error) {
            const errorMsg = error && error.message ? error.message : String(error);
            textarea.value = 'Error: ' + errorMsg;
            console.error('Pricing Request Error:', error);
            showStatusMessage('Pricing request failed', 'error', 5000);
        }
    }

    function extractPricingDocumentId(parsed) {
        if (!parsed) {
            return null;
        }
        if (parsed.documentId) {
            return parsed.documentId;
        }
        if (parsed.id) {
            return parsed.id;
        }
        if (parsed.document && parsed.document.documentId) {
            return parsed.document.documentId;
        }
        if (parsed.document && parsed.document.id) {
            return parsed.document.id;
        }
        if (parsed.documentHeader && parsed.documentHeader.documentId) {
            return parsed.documentHeader.documentId;
        }
        if (parsed.header && parsed.header.documentId) {
            return parsed.header.documentId;
        }
        return null;
    }

    // Helper function to remove empty values from objects recursively
    function removeEmpty(obj) {
        if (typeof obj !== 'object' || obj === null) {
            return obj;
        }
        
        if (Array.isArray(obj)) {
            return obj.map(removeEmpty).filter(item => {
                if (typeof item === 'object' && item !== null) {
                    return Object.keys(item).length > 0;
                }
                return item !== '' && item !== null && item !== undefined;
            });
        }
        
        return Object.keys(obj).reduce((result, key) => {
            const value = obj[key];
            const cleaned = removeEmpty(value);
            
            // Only include if not empty
            if (cleaned !== '' && cleaned !== null && cleaned !== undefined) {
                // For nested objects, only include if has properties
                if (typeof cleaned === 'object' && !Array.isArray(cleaned)) {
                    if (Object.keys(cleaned).length > 0) {
                        result[key] = cleaned;
                    }
                } else if (Array.isArray(cleaned)) {
                    if (cleaned.length > 0) {
                        result[key] = cleaned;
                    }
                } else {
                    result[key] = cleaned;
                }
            }
            return result;
        }, {});
    }

