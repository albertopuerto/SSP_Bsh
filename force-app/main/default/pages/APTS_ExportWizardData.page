<apex:page controller="APTS_ExportWizardDataController" tabStyle="Apttus__WizardDesign__c">

    <apex:sectionHeader title="" subtitle="Export Wizard Data"/>
    <apex:pageBlock > 
 	<apex:form >
 	    <p style="font-size:15px"><b>Please select the wizards from the below list that you want to export</b></p>
 	 	<apex:selectCheckboxes value="{!wizardDesignSelectedNames}">
 	 	 	<apex:selectOptions value="{!items}"/>
 	 	</apex:selectCheckboxes><br/>
 	 	<apex:commandButton value="Export" action="{!createJson}" rerender="out" status="status"/>

 	<apex:outputPanel id="out">
 	 	<apex:actionstatus id="status" startText="Exporting....">
 	 	 	<apex:facet name="stop">
 	 	 	 	<apex:outputPanel >
 	 	 	 	 	<p></p>
 	 	 	 	 	<apex:sectionHeader title="" subtitle="Wizard Design"/>
 	 	 	 	 	<apex:inputTextArea value="{!jsonWizardDesign}" disabled="true" rows="10" cols="180"/>
 	 	 	 	 	<p></p>
 	 	 	 	 	<apex:sectionHeader title="" subtitle="Wizard Steps"/>
 	 	 	 	 	<apex:inputTextArea value="{!jsonWizardStep}" disabled="true" rows="10" cols="180"/>
 	 	 	 	 	<p></p>
 	 	 	 	 	<apex:sectionHeader title="" subtitle="Wizard Input Control"/>
 	 	 	 	 	<apex:inputTextArea value="{!jsonWizardInputControl}" disabled="true" rows="10" cols="180"/>
 	 	 	 	 	<p></p>
 	 	 	 	 	<apex:sectionHeader title="" subtitle="Wizard Rule Sets"/>
 	 	 	 	 	<apex:inputTextArea value="{!jsonRuleSet}" disabled="true" rows="10" cols="180"/>
 	 	 	 	 	<p></p>
 	 	 	 	 	<apex:sectionHeader title="" subtitle="Wizard Rules"/>
 	 	 	 	 	<apex:inputTextArea value="{!jsonRules}" disabled="true" rows="10" cols="180"/>
 	 	 	 	 	
 	 	 	 	</apex:outputPanel>
 	 	 	</apex:facet>
 	 	</apex:actionstatus>
 	</apex:outputPanel>
 	</apex:form>
    </apex:pageBlock>   
</apex:page>